@model SmartParking_management.Models.ViewModels.SmartParkingViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="SmartPark — bãi đỗ xe và trạm sạc VinFast 150 chỗ. Xem sơ đồ chỗ trống thời gian thực, tra cứu bảng giá và quản lý tài khoản.">
  <title>SmartPark — Đỗ xe thông minh, không lo hết chỗ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/public-landing.css" asp-append-version="true">
</head>
<body>
  <a class="skip-link" href="#tim-bai-xe">Bỏ qua tới sơ đồ chỗ trống</a>

  <!-- TOP UTILITY BAR (Phối màu xanh đậm dịu mắt như MedEase) -->
  <div class="top-utility">
    <div class="container top-utility-inner">
      <div class="top-utility-left">
        <span><i data-icon="map-pin" data-size="13"></i> Khu Đô Thị Trung Tâm, TP. Hồ Chí Minh</span>
        <span><i data-icon="clock" data-size="13"></i> Giờ hoạt động: 24/7 (Cả Lễ &amp; Tết)</span>
      </div>
      <div class="top-utility-right">
        <a href="tel:19006868" class="num"><i data-icon="phone" data-size="13"></i> Hotline: 1900 6868</a>
        <a href="#ho-tro-247">Hỗ trợ &amp; Tư vấn</a>
      </div>
    </div>
  </div>

  <!-- 1. NAVBAR (Cao 64px, viền dưới 1px) -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand" aria-label="SmartPark — Trang chủ">
        <span class="brand-mark" aria-hidden="true">P</span>
        <span class="brand-text">
          <span class="brand-name">SmartPark</span>
          <span class="brand-tagline">Đỗ xe thông minh, không lo hết chỗ</span>
        </span>
      </a>

      <nav class="nav-links" aria-label="Điều hướng chính">
        <a href="#tim-bai-xe">Tìm bãi xe</a>
        <a href="#cach-thuc-hoat-dong">Cách thức hoạt động</a>
        <a href="#bang-gia">Bảng giá</a>
        <a href="#ho-tro-247">Hỗ trợ 24/7</a>
      </nav>

      <div class="nav-actions">
        <a href="#tim-bai-xe" class="btn btn-emerald" data-action="find-available">
          <i data-icon="calendar" data-size="15"></i> Đặt chỗ ngay
        </a>

        <!-- Khi chưa đăng nhập -->
        <a href="/Account/Login" class="btn btn-outline" id="nav-guest-login">Đăng nhập / Đăng ký</a>

        <!-- Khi đã đăng nhập: Nút Account + Menu Dropdown (Giống mẫu MedEase nhưng đúng nghiệp vụ Bãi xe) -->
        <div class="account-menu-wrap" id="nav-user-wrap" hidden>
          <button type="button" class="account-trigger" id="account-trigger-btn" aria-expanded="false" aria-haspopup="true">
            <i data-icon="user-circle" data-size="17"></i>
            <span id="account-trigger-label">Phạm Minh Khách (Khách Hàng)</span>
            <i data-icon="chevron-down" data-size="14"></i>
          </button>

          <div class="account-dropdown" id="account-dropdown" role="menu" hidden>
            <div class="account-dropdown-head">
              <strong id="dropdown-user-name">Phạm Minh Khách (Khách Hàng)</strong>
              <span id="dropdown-user-role">Khách hàng</span>
            </div>
            <div class="account-dropdown-list" id="dropdown-menu-items">
              <button type="button" class="account-item" data-menu-action="my-bookings" role="menuitem">
                <i data-icon="calendar" data-size="16"></i>
                <span>Lịch đặt chỗ &amp; Vé QR của tôi</span>
              </button>
              <button type="button" class="account-item" data-menu-action="my-vehicles" role="menuitem">
                <i data-icon="car" data-size="16"></i>
                <span>Phương tiện &amp; Biển số đã lưu</span>
              </button>
              <button type="button" class="account-item" data-menu-action="notifications" role="menuitem">
                <i data-icon="bell" data-size="16"></i>
                <span>Thông báo &amp; Nhắc giờ đỗ xe</span>
              </button>
              <button type="button" class="account-item" data-menu-action="profile" role="menuitem">
                <i data-icon="id-card" data-size="16"></i>
                <span>Hồ sơ cá nhân</span>
              </button>
            </div>
            <div class="account-dropdown-foot">
              <button type="button" class="account-logout" id="account-logout-btn" role="menuitem">
                <i data-icon="log-out" data-size="16"></i>
                <span>Đăng xuất</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Thanh thông báo chào mừng khi đăng nhập thành công -->
  <div class="welcome-banner-wrap" id="welcome-banner" hidden>
    <div class="container">
      <div class="welcome-banner">
        <i data-icon="check-circle" data-size="18"></i>
        <span id="welcome-banner-text">Đăng nhập thành công! Chào mừng Phạm Minh Khách (Khách Hàng).</span>
      </div>
    </div>
  </div>

  <main>
    <!-- 2. HERO (Nền xanh rừng đậm dịu mắt phối trắng & xanh ngọc lục bảo) -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">BÃI ĐỖ XE &amp; TRẠM SẠC VINFAST • <span class="num">150</span> CHỖ</p>
          <h1 id="hero-title">Đỗ xe thông minh, đặt chỗ trước chỉ trong 30 giây</h1>
          <p class="lead">Xem chỗ trống theo từng ô, đặt lịch theo biển số và nhận vé QR ngay trên điện thoại. Đến bãi chỉ cần đưa mã cho nhân viên quét.</p>

          <dl class="hero-stats">
            <div class="hero-stat">
              <dt><i data-icon="square-parking"></i> Chỗ trống</dt>
              <dd><span class="num" id="hero-available">52</span> <span class="unit">chỗ trống</span></dd>
            </div>
            <div class="hero-stat">
              <dt><i data-icon="plug-zap"></i> Trạm sạc</dt>
              <dd><span class="num">12</span> <span class="unit">trụ sạc EV</span></dd>
            </div>
            <div class="hero-stat">
              <dt><i data-icon="qr-code"></i> Vào bãi</dt>
              <dd><span class="num">QR</span> <span class="unit">Check-in</span></dd>
            </div>
          </dl>

          <div class="hero-actions">
            <a href="#tim-bai-xe" class="btn btn-emerald btn-lg" data-action="find-available">
              Tìm chỗ trống ngay <i data-icon="arrow-right"></i>
            </a>
            <a href="#bang-gia" class="btn btn-hero-ghost btn-lg">Xem bảng giá</a>
          </div>
        </div>

        <figure class="hero-media">
          <img src="/images/parking-map-3d.webp" width="1024" height="572" fetchpriority="high"
               alt="Phối cảnh 3D bãi đỗ xe SmartPark: khu sạc xe điện, khu ngoài trời, lối xuống tầng hầm B1 và khu VIP mái che">
          <figcaption class="hero-legend">
            <span><i class="sw sw-ev"></i>Zone EV · 37</span>
            <span><i class="sw sw-nt"></i>Ngoài trời · 65</span>
            <span><i class="sw sw-th"></i>Tầng hầm B1 · 40</span>
            <span><i class="sw sw-vip"></i>VIP · 8</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. 01 / BẢN ĐỒ CHỖ TRỐNG -->
    <section id="tim-bai-xe" class="section" aria-labelledby="map-title">
      <div class="container">
        <div class="section-head">
          <div class="section-title">
            <p class="section-index">01 / BẢN ĐỒ CHỖ TRỐNG THỜI GIAN THỰC</p>
            <h2 id="map-title">Sơ đồ 150 ô đỗ theo 4 phân khu</h2>
            <p class="section-desc">Bấm vào từng ô trên sơ đồ để xem chi tiết mã ô, khu vực, loại xe, đơn giá và trạng thái hiện tại.</p>
          </div>
          <div class="status-tabs" role="group" aria-label="Lọc theo trạng thái">
            <button type="button" class="tab is-active" data-status="ALL" aria-pressed="true">Tất cả <span class="num" data-count="ALL">150</span></button>
            <button type="button" class="tab" data-status="AVAILABLE" aria-pressed="false"><i class="dot dot-available"></i>Còn trống <span class="num" data-count="AVAILABLE">52</span></button>
            <button type="button" class="tab" data-status="OCCUPIED" aria-pressed="false"><i class="dot dot-occupied"></i>Đang đỗ <span class="num" data-count="OCCUPIED">75</span></button>
            <button type="button" class="tab" data-status="CHARGING" aria-pressed="false"><i class="dot dot-charging"></i>Đang sạc <span class="num" data-count="CHARGING">12</span></button>
            <button type="button" class="tab" data-status="RESERVED" aria-pressed="false"><i class="dot dot-reserved"></i>Đã đặt trước <span class="num" data-count="RESERVED">11</span></button>
          </div>
        </div>

        <!-- 4 thẻ phân khu -->
        <div class="zone-grid">
          <article class="zone-card" data-zone-card="EV">
            <div class="zone-card-head">
              <span class="zone-tag zone-tag-ev">ZONE EV</span>
              <span class="zone-free"><span class="num" data-zone-free="EV">13</span>/<span class="num">37</span> trống</span>
            </div>
            <h3>Khu Chuyên biệt Xe Điện</h3>
            <p class="zone-capacity"><span class="num">37</span> chỗ</p>
            <ul class="zone-specs">
              <li><i data-icon="car"></i><span><span class="num">12</span> Ô tô điện <span class="code">EV-O01..O12</span></span></li>
              <li><i data-icon="bike"></i><span><span class="num">25</span> Xe máy điện <span class="code">EV-X01..X25</span></span></li>
              <li><i data-icon="plug-zap"></i><span>Trụ sạc VinFast, vách ngăn PCCC</span></li>
            </ul>
            <div class="zone-price">
              <span class="zone-price-label">Giá</span>
              <span class="zone-price-value num">20.000đ/giờ + 4.500đ/kWh</span>
            </div>
            <div class="meter" aria-hidden="true"><span data-zone-meter="EV"></span></div>
            <button type="button" class="btn btn-outline btn-block" data-zone-pick="EV">Xem ô trống khu này</button>
          </article>

          <article class="zone-card" data-zone-card="NT">
            <div class="zone-card-head">
              <span class="zone-tag zone-tag-nt">ZONE NT</span>
              <span class="zone-free"><span class="num" data-zone-free="NT">23</span>/<span class="num">65</span> trống</span>
            </div>
            <h3>Khu Ngoài Trời</h3>
            <p class="zone-capacity"><span class="num">65</span> chỗ</p>
            <ul class="zone-specs">
              <li><i data-icon="car"></i><span><span class="num">20</span> Ô tô xăng <span class="code">NT-O01..O20</span></span></li>
              <li><i data-icon="bike"></i><span><span class="num">45</span> Xe máy xăng <span class="code">NT-X01..X45</span></span></li>
              <li><i data-icon="sun"></i><span>Bãi mặt đất, gần lối ra đường chính</span></li>
            </ul>
            <div class="zone-price">
              <span class="zone-price-label">Giá</span>
              <span class="zone-price-value num">Ô tô 15.000đ/giờ | Xe máy 5.000đ/4h</span>
            </div>
            <div class="meter" aria-hidden="true"><span data-zone-meter="NT"></span></div>
            <button type="button" class="btn btn-outline btn-block" data-zone-pick="NT">Xem ô trống khu này</button>
          </article>

          <article class="zone-card" data-zone-card="TH">
            <div class="zone-card-head">
              <span class="zone-tag zone-tag-th">ZONE TH</span>
              <span class="zone-free"><span class="num" data-zone-free="TH">13</span>/<span class="num">40</span> trống</span>
            </div>
            <h3>Tầng Hầm B1</h3>
            <p class="zone-capacity"><span class="num">40</span> chỗ</p>
            <ul class="zone-specs">
              <li><i data-icon="car"></i><span><span class="num">10</span> Ô tô xăng <span class="code">TH-O01..O10</span></span></li>
              <li><i data-icon="bike"></i><span><span class="num">30</span> Xe máy xăng <span class="code">TH-X01..X30</span></span></li>
              <li class="spec-warn"><i data-icon="flame"></i><span>Chỉ nhận xe xăng</span></li>
            </ul>
            <div class="zone-price">
              <span class="zone-price-label">Giá</span>
              <span class="zone-price-value num">Ô tô 20.000đ/giờ</span>
            </div>
            <div class="meter" aria-hidden="true"><span data-zone-meter="TH"></span></div>
            <button type="button" class="btn btn-outline btn-block" data-zone-pick="TH">Xem ô trống khu này</button>
          </article>

          <article class="zone-card" data-zone-card="VIP">
            <div class="zone-card-head">
              <span class="zone-tag zone-tag-vip">ZONE VIP</span>
              <span class="zone-free"><span class="num" data-zone-free="VIP">3</span>/<span class="num">8</span> trống</span>
            </div>
            <h3>Khu VIP Mái Che</h3>
            <p class="zone-capacity"><span class="num">8</span> chỗ</p>
            <ul class="zone-specs">
              <li><i data-icon="car"></i><span><span class="num">8</span> Ô tô xăng <span class="code">VIP-O01..O08</span></span></li>
              <li><i data-icon="warehouse"></i><span>Có mái che, sát cổng ra vào</span></li>
              <li><i data-icon="calendar"></i><span>Bắt buộc đặt trước</span></li>
            </ul>
            <div class="zone-price">
              <span class="zone-price-label">Giá</span>
              <span class="zone-price-value num">30.000đ/giờ</span>
            </div>
            <div class="meter" aria-hidden="true"><span data-zone-meter="VIP"></span></div>
            <button type="button" class="btn btn-outline btn-block" data-zone-pick="VIP">Xem ô trống khu này</button>
          </article>
        </div>

        <!-- Thanh công cụ lọc -->
        <div class="toolbar" role="search" aria-label="Lọc ô đỗ">
          <label class="field field-search">
            <span class="sr-only">Tìm mã ô</span>
            <i data-icon="search"></i>
            <input type="search" id="filter-code" placeholder="Tìm mã ô (VD: EV-O03)" autocomplete="off" spellcheck="false">
          </label>
          <label class="field">
            <span class="sr-only">Khu vực</span>
            <select id="filter-zone">
              <option value="ALL">Tất cả khu vực</option>
              <option value="EV">Zone EV — Khu Xe Điện</option>
              <option value="NT">Zone NT — Ngoài Trời</option>
              <option value="TH">Zone TH — Tầng Hầm B1</option>
              <option value="VIP">Zone VIP — Mái Che</option>
            </select>
          </label>
          <label class="field">
            <span class="sr-only">Loại xe</span>
            <select id="filter-vehicle">
              <option value="ALL">Tất cả loại xe</option>
              <option value="GAS_CAR">Ô tô xăng</option>
              <option value="GAS_BIKE">Xe máy xăng</option>
              <option value="EV_CAR">Ô tô điện</option>
              <option value="EV_BIKE">Xe máy điện</option>
            </select>
          </label>
          <label class="switch">
            <input type="checkbox" id="filter-available" role="switch">
            <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
            <span>Chỉ hiện ô trống</span>
          </label>
        </div>

        <div class="notice notice-warn" id="pccc-notice" role="status" hidden>
          <i data-icon="flame"></i>
          <p><strong>Tầng hầm B1 không nhận xe điện.</strong> Theo quy định PCCC, các ô tại Zone TH đã được khóa với loại xe bạn chọn. Vui lòng chọn ô tại Zone EV.</p>
        </div>

        <div class="map-meta">
          <ul class="legend" aria-label="Chú thích trạng thái">
            <li><i class="dot dot-available"></i>Còn trống</li>
            <li><i class="dot dot-occupied"></i>Đang đỗ</li>
            <li><i class="dot dot-charging"></i>Đang sạc</li>
            <li><i class="dot dot-reserved"></i>Đã đặt trước</li>
            <li><i data-icon="lock" data-size="13"></i>Khóa theo PCCC</li>
          </ul>
          <p class="map-result" id="map-result" aria-live="polite"></p>
        </div>

        <!-- Sơ đồ lưới 150 ô -->
        <div id="slot-map" class="slot-map"></div>
      </div>
    </section>

    <!-- 4. 02 / BẢNG GIÁ -->
    <section id="bang-gia" class="section section-subtle" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section-head">
          <div class="section-title">
            <p class="section-index">02 / BẢNG GIÁ &amp; GÓI VÉ THÁNG</p>
            <h2 id="pricing-title">Gửi theo giờ hoặc giữ chỗ cố định theo tháng</h2>
            <p class="section-desc">Giá niêm yết đã gồm VAT. Mọi quy định phụ phí được công khai minh bạch.</p>
          </div>
        </div>

        <div class="pricing-grid">
          <div class="panel">
            <div class="panel-head">
              <div>
                <h3>Gửi theo giờ</h3>
                <p>Tính theo thời gian đỗ thực tế, làm tròn lên theo block.</p>
              </div>
              <i data-icon="clock" data-size="20"></i>
            </div>
            <div class="table-wrap">
              <table class="price-table">
                <thead>
                  <tr><th scope="col">Khu vực</th><th scope="col">Loại xe</th><th scope="col" class="t-right">Đơn giá</th></tr>
                </thead>
                <tbody>
                  <tr><td><span class="zone-tag zone-tag-ev">EV</span></td><td>Ô tô điện</td><td class="t-right num">20.000đ/giờ <span class="sub">+ 4.500đ/kWh</span></td></tr>
                  <tr><td><span class="zone-tag zone-tag-ev">EV</span></td><td>Xe máy điện</td><td class="t-right num">5.000đ/4h <span class="sub">+ 4.500đ/kWh</span></td></tr>
                  <tr><td><span class="zone-tag zone-tag-nt">NT</span></td><td>Ô tô xăng</td><td class="t-right num">15.000đ/giờ</td></tr>
                  <tr><td><span class="zone-tag zone-tag-nt">NT</span></td><td>Xe máy xăng</td><td class="t-right num">5.000đ/4h</td></tr>
                  <tr><td><span class="zone-tag zone-tag-th">TH</span></td><td>Ô tô xăng</td><td class="t-right num">20.000đ/giờ</td></tr>
                  <tr><td><span class="zone-tag zone-tag-th">TH</span></td><td>Xe máy xăng</td><td class="t-right num">5.000đ/4h</td></tr>
                  <tr><td><span class="zone-tag zone-tag-vip">VIP</span></td><td>Ô tô xăng <span class="sub">Bắt buộc đặt trước</span></td><td class="t-right num">30.000đ/giờ</td></tr>
                </tbody>
              </table>
            </div>
            <ul class="rule-list">
              <li><i data-icon="plug-zap"></i><span><strong>Phí chiếm trụ sạc <span class="num">1.000đ/phút</span></strong> — áp dụng khi xe vẫn chiếm trụ quá 10 phút sau khi đã sạc đầy.</span></li>
              <li><i data-icon="clock"></i><span><strong>Ân hạn 15 phút</strong> sau giờ ra đã đặt. Quá thời gian ân hạn, phần vượt tính <span class="num">1.5x</span> đơn giá.</span></li>
            </ul>
          </div>

          <div class="panel">
            <div class="panel-head">
              <div>
                <h3>Vé tháng cố định chỗ</h3>
                <p>Giữ riêng một ô đỗ, ra vào không giới hạn bằng vé QR.</p>
              </div>
              <i data-icon="calendar" data-size="20"></i>
            </div>
            <div class="segmented" role="group" aria-label="Chọn kỳ hạn">
              <button type="button" class="seg is-active" data-months="1" aria-pressed="true">1 tháng</button>
              <button type="button" class="seg" data-months="3" aria-pressed="false">3 tháng <span class="seg-off">−5%</span></button>
              <button type="button" class="seg" data-months="6" aria-pressed="false">6 tháng <span class="seg-off">−10%</span></button>
              <button type="button" class="seg" data-months="12" aria-pressed="false">12 tháng <span class="seg-off">−15%</span></button>
            </div>
            <div class="table-wrap">
              <table class="price-table">
                <thead>
                  <tr><th scope="col">Gói cố định chỗ</th><th scope="col" class="t-right">Giá/tháng</th><th scope="col" class="t-right" id="monthly-total-head">Tổng 1 tháng</th></tr>
                </thead>
                <tbody id="monthly-body"></tbody>
              </table>
            </div>
            <p class="fine">Vé tháng xe điện chưa gồm điện sạc (4.500đ/kWh). Phí chiếm trụ sạc vẫn áp dụng.</p>
            <a href="/Account/Login" class="btn btn-emerald btn-block" id="monthly-cta-btn">Đăng nhập để đăng ký vé tháng</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. 03 / CÁCH THỨC HOẠT ĐỘNG -->
    <section id="cach-thuc-hoat-dong" class="section" aria-labelledby="how-title">
      <div class="container">
        <div class="section-head">
          <div class="section-title">
            <p class="section-index">03 / CÁCH THỨC HOẠT ĐỘNG</p>
            <h2 id="how-title">4 bước từ đặt chỗ đến lấy xe</h2>
          </div>
        </div>
        <ol class="steps">
          <li class="step">
            <span class="step-num num">1</span>
            <i data-icon="map-pin" data-size="20"></i>
            <h3>Chọn ô trống</h3>
            <p>Lọc theo khu vực và loại xe trên sơ đồ 150 ô, chọn một ô màu xanh.</p>
          </li>
          <li class="step">
            <span class="step-num num">2</span>
            <i data-icon="calendar" data-size="20"></i>
            <h3>Đặt lịch theo biển số</h3>
            <p>Nhập biển số, giờ vào và giờ ra. Tạm tính hiển thị trước khi xác nhận.</p>
          </li>
          <li class="step">
            <span class="step-num num">3</span>
            <i data-icon="qr-code" data-size="20"></i>
            <h3>Nhận vé QR</h3>
            <p>Vé QR hiện ngay sau khi đặt. Lưu lại hoặc chụp màn hình để dùng khi vào bãi.</p>
          </li>
          <li class="step">
            <span class="step-num num">4</span>
            <i data-icon="ticket" data-size="20"></i>
            <h3>Quét vé khi vào và ra</h3>
            <p>Nhân viên quét vé, đối chiếu biển số. Thanh toán theo thời gian thực tế khi lấy xe.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- 6. 04 / HỖ TRỢ 24/7 -->
    <section id="ho-tro-247" class="section section-subtle" aria-labelledby="support-title">
      <div class="container support-grid">
        <div>
          <p class="section-index">04 / HỖ TRỢ 24/7</p>
          <h2 id="support-title">Cần hỗ trợ khi đang ở bãi?</h2>
          <p class="section-desc">Nhân viên trực tại cổng và qua hotline suốt 24 giờ.</p>

          <div class="panel hotline">
            <i data-icon="phone" data-size="20"></i>
            <div>
              <span class="hotline-label">Hotline 24/7</span>
              <a href="tel:19006868" class="hotline-number num">1900 6868</a>
            </div>
          </div>
        </div>

        <div class="faq">
          <details open>
            <summary>Đến muộn hơn giờ đã đặt thì sao? <i data-icon="chevron-down"></i></summary>
            <p>Ô được giữ thêm 15 phút sau giờ vào. Quá 15 phút chưa check-in, lịch đặt tự hủy và ô được mở lại cho khách khác.</p>
          </details>
          <details>
            <summary>Lấy xe trễ hơn giờ ra đã đặt tính phí thế nào? <i data-icon="chevron-down"></i></summary>
            <p>Bạn có 15 phút ân hạn. Sau đó, thời gian vượt được tính bằng 1.5 lần đơn giá của khu vực đang gửi.</p>
          </details>
          <details>
            <summary>Xe điện có được gửi ở tầng hầm không? <i data-icon="chevron-down"></i></summary>
            <p>Không. Theo quy định PCCC, Tầng hầm B1 chỉ nhận xe xăng. Ô tô điện và xe máy điện gửi tại Zone EV, có vách ngăn chống cháy và trụ sạc riêng.</p>
          </details>
          <details>
            <summary>Phí chiếm trụ sạc được tính khi nào? <i data-icon="chevron-down"></i></summary>
            <p>Khi xe đã sạc đầy nhưng vẫn chiếm trụ quá 10 phút, mỗi phút tiếp theo tính 1.000đ. Điện sạc tính riêng 4.500đ/kWh theo đồng hồ của trụ.</p>
          </details>
          <details>
            <summary>Hủy đặt chỗ có mất phí không? <i data-icon="chevron-down"></i></summary>
            <p>Không mất phí nếu hủy trước giờ vào đã đặt. Gọi hotline 1900 6868 và cung cấp mã vé để hủy.</p>
          </details>
        </div>
      </div>
    </section>
  </main>

