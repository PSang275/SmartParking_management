@model SmartParking_management.Models.ViewModels.SmartParkingViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="SmartPark — Hệ thống quản lý bãi đỗ xe thông minh và trạm sạc VinFast 150 chỗ. Xem sơ đồ chỗ trống thời gian thực, đặt chỗ nhận vé QR và đăng ký gói vé tháng cố định chỗ.">
  <title>SmartPark — Đỗ xe thông minh, đặt chỗ trực tuyến &amp; Vé QR</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/public-landing.css" asp-append-version="true">
</head>
<body>
  <a class="skip-link" href="#so-do-bai-xe">Bỏ qua tới sơ đồ 150 vị trí đỗ</a>

  <!-- TOP UTILITY BAR -->
  <div class="top-utility">
    <div class="container top-utility-inner">
      <div class="top-utility-left">
        <span><i data-icon="map-pin" data-size="13"></i> Khu Đô Thị Trung Tâm, TP. Hồ Chí Minh</span>
        <span><i data-icon="clock" data-size="13"></i> Vận hành 24/7 • Đồng bộ dữ liệu thời gian thực</span>
      </div>
      <div class="top-utility-right">
        <a href="tel:19006868" class="num"><i data-icon="phone" data-size="13"></i> Hotline: 1900 6868</a>
        <a href="#ho-tro-247">Hướng dẫn &amp; Hỗ trợ</a>
      </div>
    </div>
  </div>

  <!-- 1. NAVBAR (Cao 64px, viền dưới 1px) -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand" aria-label="SmartPark — Trang chủ">
        <span class="brand-mark" aria-hidden="true">P</span>
        <span class="brand-text">
          <span class="brand-name">SmartPark</span>
          <span class="brand-tagline">Đỗ xe thông minh, không lo hết chỗ</span>
        </span>
      </a>

      <nav class="nav-links" aria-label="Điều hướng chính">
        <a href="#so-do-bai-xe">Sơ đồ 150 chỗ</a>
        <a href="#goi-ve-thang">Gói vé tháng cố định chỗ</a>
        <a href="#cach-thuc-hoat-dong">Quy trình đặt chỗ</a>
        <a href="#ho-tro-247">Hỗ trợ 24/7</a>
      </nav>

      <div class="nav-actions">
        <button type="button" class="btn btn-emerald" id="nav-quick-book-btn">
          <i data-icon="calendar" data-size="15"></i> Đặt chỗ ngay
        </button>

        <!-- Khi chưa đăng nhập -->
        <a href="/Account/Login" class="btn btn-outline" id="nav-guest-login">Đăng nhập / Đăng ký</a>

        <!-- Khi đã đăng nhập: Nút Account + Menu Dropdown (US17) -->
        <div class="account-menu-wrap" id="nav-user-wrap" hidden>
          <button type="button" class="account-trigger" id="account-trigger-btn" aria-expanded="false" aria-haspopup="true">
            <i data-icon="user-circle" data-size="17"></i>
            <span id="account-trigger-label">Phạm Minh Khách (Khách Hàng)</span>
            <i data-icon="chevron-down" data-size="14"></i>
          </button>

          <div class="account-dropdown" id="account-dropdown" role="menu" hidden>
            <div class="account-dropdown-head">
              <strong id="dropdown-user-name">Phạm Minh Khách (Khách Hàng)</strong>
              <span id="dropdown-user-role">Khách hàng</span>
            </div>
            <div class="account-dropdown-list" id="dropdown-menu-items">
              <button type="button" class="account-item" data-menu-action="my-bookings" role="menuitem">
                <i data-icon="qr-code" data-size="16"></i>
                <span>Lịch đặt chỗ &amp; Vé QR đã sinh</span>
              </button>
              <button type="button" class="account-item" data-menu-action="my-monthly-passes" role="menuitem">
                <i data-icon="calendar" data-size="16"></i>
                <span>Gói vé tháng cố định chỗ</span>
              </button>
              <button type="button" class="account-item" data-menu-action="profile" role="menuitem">
                <i data-icon="id-card" data-size="16"></i>
                <span>Hồ sơ tài khoản</span>
              </button>
            </div>
            <div class="account-dropdown-foot">
              <button type="button" class="account-logout" id="account-logout-btn" role="menuitem">
                <i data-icon="log-out" data-size="16"></i>
                <span>Đăng xuất</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Thanh thông báo chào mừng khi đăng nhập thành công -->
  <div class="welcome-banner-wrap" id="welcome-banner" hidden>
    <div class="container">
      <div class="welcome-banner">
        <i data-icon="check-circle" data-size="18"></i>
        <span id="welcome-banner-text">Đăng nhập thành công! Chào mừng Phạm Minh Khách (Khách Hàng).</span>
      </div>
    </div>
  </div>

  <main>
    <!-- 2. HERO (Royal Navy Blue + White + Slate Ink) -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">BÃI ĐỖ XE &amp; TRẠM SẠC VINFAST • <span class="num">150</span> VỊ TRÍ ĐỖ</p>
          <h1 id="hero-title">Đặt chỗ đỗ xe trực tuyến, nhận vé QR chỉ trong 30 giây</h1>
          <p class="lead">Theo dõi trực tiếp sơ đồ 150 ô đỗ thuộc 4 phân khu chuyên biệt, đặt giữ chỗ theo khung giờ chống trùng lịch và đăng ký gói vé tháng khóa ô cố định.</p>

          <dl class="hero-stats">
            <div class="hero-stat">
              <dt><i data-icon="square-parking"></i> Chỗ trống</dt>
              <dd><span class="num" id="hero-available">52</span> <span class="unit">ô sẵn sàng</span></dd>
            </div>
            <div class="hero-stat">
              <dt><i data-icon="plug-zap"></i> Trạm sạc</dt>
              <dd><span class="num">12</span> <span class="unit">trụ sạc EV</span></dd>
            </div>
            <div class="hero-stat">
              <dt><i data-icon="qr-code"></i> Vé điện tử</dt>
              <dd><span class="num">QR</span> <span class="unit">Định danh</span></dd>
            </div>
          </dl>

          <div class="hero-actions">
            <a href="#so-do-bai-xe" class="btn btn-emerald btn-lg">
              Chọn ô đặt chỗ ngay <i data-icon="arrow-right"></i>
            </a>
            <a href="#goi-ve-thang" class="btn btn-hero-ghost btn-lg">Đăng ký gói vé tháng</a>
          </div>
        </div>

        <figure class="hero-media">
          <img src="/images/parking-map-3d.webp" width="1024" height="572" fetchpriority="high"
               alt="Phối cảnh 3D bãi đỗ xe SmartPark: khu sạc xe điện, khu ngoài trời, lối xuống tầng hầm B1 và khu VIP mái che">
          <figcaption class="hero-legend">
            <span><i class="sw sw-ev"></i>Zone EV · 37</span>
            <span><i class="sw sw-nt"></i>Ngoài trời · 65</span>
            <span><i class="sw sw-th"></i>Tầng hầm B1 · 40</span>
            <span><i class="sw sw-vip"></i>VIP · 8</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. 01 / SƠ ĐỒ BÃI XE 150 CHỖ THỜI GIAN THỰC (US02) & ĐẶT CHỖ TRỰC TUYẾN (US07-US08) -->
    <section id="so-do-bai-xe" class="section" aria-labelledby="map-title">
      <div class="container">
        <div class="section-head">
          <div class="section-title">
            <p class="section-index">01 / SƠ ĐỒ BÃI XE THỜI GIAN THỰC</p>
            <h2 id="map-title">Sơ đồ 150 vị trí đỗ theo 4 phân khu (EV, NT, TH, VIP)</h2>
            <p class="section-desc">Bấm vào bất kỳ ô màu xanh lá (Còn trống) trên sơ đồ để đặt chỗ trực tuyến theo khung giờ dự kiến và nhận mã vé QR ngay lập tức.</p>
          </div>
        </div>

        <!-- 4 thẻ tổng quan phân khu -->
        <div class="zone-grid">
          <article class="zone-card" data-zone-card="EV">
            <div class="zone-card-head">
              <span class="zone-tag zone-tag-ev">ZONE EV</span>
              <span class="zone-free"><span class="num" data-zone-free="EV">13</span>/<span class="num">37</span> trống</span>
            </div>
            <h3>Khu Chuyên biệt Xe Điện</h3>
            <p class="zone-capacity"><span class="num">37</span> chỗ</p>
            <ul class="zone-specs">
              <li><i data-icon="car"></i><span><span class="num">12</span> Ô tô điện <span class="code">EV-O01..O12</span></span></li>
              <li><i data-icon="bike"></i><span><span class="num">25</span> Xe máy điện <span class="code">EV-X01..X25</span></span></li>
              <li><i data-icon="plug-zap"></i><span>12 trụ sạc VinFast, vách ngăn PCCC</span></li>
            </ul>
            <div class="meter" aria-hidden="true"><span data-zone-meter="EV"></span></div>
          </article>

          <article class="zone-card" data-zone-card="NT">
            <div class="zone-card-head">
              <span class="zone-tag zone-tag-nt">ZONE NT</span>
              <span class="zone-free"><span class="num" data-zone-free="NT">23</span>/<span class="num">65</span> trống</span>
            </div>
            <h3>Khu Ngoài Trời</h3>
            <p class="zone-capacity"><span class="num">65</span> chỗ</p>
            <ul class="zone-specs">
              <li><i data-icon="car"></i><span><span class="num">20</span> Ô tô xăng <span class="code">NT-O01..O20</span></span></li>
              <li><i data-icon="bike"></i><span><span class="num">45</span> Xe máy xăng <span class="code">NT-X01..X45</span></span></li>
              <li><i data-icon="sun"></i><span>Bãi mặt đất thoáng rộng sát lối ra chính</span></li>
            </ul>
            <div class="meter" aria-hidden="true"><span data-zone-meter="NT"></span></div>
          </article>

          <article class="zone-card" data-zone-card="TH">
            <div class="zone-card-head">
              <span class="zone-tag zone-tag-th">ZONE TH</span>
              <span class="zone-free"><span class="num" data-zone-free="TH">13</span>/<span class="num">40</span> trống</span>
            </div>
            <h3>Tầng Hầm B1</h3>
            <p class="zone-capacity"><span class="num">40</span> chỗ</p>
            <ul class="zone-specs">
              <li><i data-icon="car"></i><span><span class="num">10</span> Ô tô xăng <span class="code">TH-O01..O10</span></span></li>
              <li><i data-icon="bike"></i><span><span class="num">30</span> Xe máy xăng <span class="code">TH-X01..X30</span></span></li>
              <li class="spec-warn"><i data-icon="flame"></i><span>An toàn PCCC: Chỉ nhận xe xăng</span></li>
            </ul>
            <div class="meter" aria-hidden="true"><span data-zone-meter="TH"></span></div>
          </article>

          <article class="zone-card" data-zone-card="VIP">
            <div class="zone-card-head">
              <span class="zone-tag zone-tag-vip">ZONE VIP</span>
              <span class="zone-free"><span class="num" data-zone-free="VIP">3</span>/<span class="num">8</span> trống</span>
            </div>
            <h3>Khu VIP Mái Che</h3>
            <p class="zone-capacity"><span class="num">8</span> chỗ</p>
            <ul class="zone-specs">
              <li><i data-icon="car"></i><span><span class="num">8</span> Ô tô xăng <span class="code">VIP-O01..O08</span></span></li>
              <li><i data-icon="warehouse"></i><span>Có mái che riêng sát cổng kiểm soát</span></li>
              <li><i data-icon="calendar"></i><span>Ưu tiên đặt lịch trực tuyến</span></li>
            </ul>
            <div class="meter" aria-hidden="true"><span data-zone-meter="VIP"></span></div>
          </article>
        </div>

        <div class="map-meta">
          <ul class="legend" aria-label="Chú thích trạng thái ô đỗ">
            <li><i class="dot dot-available"></i>Còn trống (Bấm để đặt chỗ)</li>
            <li><i class="dot dot-occupied"></i>Đang đỗ</li>
            <li><i class="dot dot-charging"></i>Đang sạc EV</li>
            <li><i class="dot dot-reserved"></i>Đã đặt trước / Cố định tháng</li>
          </ul>
          <p class="map-result" id="map-result" aria-live="polite"></p>
        </div>

        <!-- Sơ đồ lưới 150 ô -->
        <div id="slot-map" class="slot-map"></div>
      </div>
    </section>

    <!-- 4. 02 / ĐĂNG KÝ & GIA HẠN GÓI VÉ THÁNG CỐ ĐỊNH CHỖ (US28) -->
    <section id="goi-ve-thang" class="section section-subtle" aria-labelledby="monthly-title">
      <div class="container">
        <div class="section-head">
          <div class="section-title">
            <p class="section-index">02 / GÓI VÉ THÁNG CỐ ĐỊNH CHỖ</p>
            <h2 id="monthly-title">Đăng ký &amp; Gia hạn gói vé tháng khóa riêng một vị trí đỗ</h2>
            <p class="section-desc">Ưu đãi kỳ hạn 1 – 3 – 6 – 12 tháng (giảm đến 15%). Hệ thống tự động kiểm tra khóa trùng ô và quy định an toàn PCCC tầng hầm B1.</p>
          </div>
        </div>

        <div class="mp-layout">
          <!-- Form đăng ký gói vé tháng cố định chỗ -->
          <div class="panel">
            <div class="panel-head">
              <div>
                <h3>Đăng ký gói vé tháng cố định chỗ mới</h3>
                <p>Chọn kỳ hạn, phân khu và vị trí ô trống muốn khóa cố định theo biển số xe.</p>
              </div>
              <i data-icon="calendar" data-size="20"></i>
            </div>

            <div class="segmented" role="group" aria-label="Chọn kỳ hạn vé tháng" id="mp-term-tabs">
              <button type="button" class="seg is-active" data-months="1" aria-pressed="true">1 tháng</button>
              <button type="button" class="seg" data-months="3" aria-pressed="false">3 tháng <span class="seg-off">-5%</span></button>
              <button type="button" class="seg" data-months="6" aria-pressed="false">6 tháng <span class="seg-off">-10%</span></button>
              <button type="button" class="seg" data-months="12" aria-pressed="false">12 tháng <span class="seg-off">-15%</span></button>
            </div>

            <form id="mp-register-form" class="sp-form" novalidate>
              <div class="sp-field-grid">
                <div class="sp-field">
                  <label class="sp-label" for="mp-zone">Phân khu đăng ký *</label>
                  <select id="mp-zone" class="sp-select">
                    <option value="EV">Zone EV — Khu Xe Điện (37 ô)</option>
                    <option value="NT" selected>Zone NT — Khu Ngoài Trời (65 ô)</option>
                    <option value="TH">Zone TH — Tầng Hầm B1 (40 ô)</option>
                    <option value="VIP">Zone VIP — Khu VIP Mái Che (8 ô)</option>
                  </select>
                </div>

                <div class="sp-field">
                  <label class="sp-label" for="mp-vehicle-type">Loại phương tiện *</label>
                  <select id="mp-vehicle-type" class="sp-select">
                    <option value="GAS_CAR" selected>Ô tô xăng</option>
                    <option value="GAS_BIKE">Xe máy xăng</option>
                    <option value="EV_CAR">Ô tô điện</option>
                    <option value="EV_BIKE">Xe máy điện</option>
                  </select>
                </div>
              </div>

              <div class="sp-pccc-alert" id="mp-pccc-warning" role="alert" hidden>
                <i data-icon="flame" data-size="18"></i>
                <span><strong>Khóa an toàn PCCC:</strong> Tầng hầm B1 (Zone TH) chỉ nhận xe xăng, không nhận đăng ký vé tháng cho xe điện. Vui lòng chuyển sang Zone EV.</span>
              </div>

              <div class="sp-field-grid">
                <div class="sp-field">
                  <label class="sp-label" for="mp-slot-select">Chọn ô cố định còn trống (Chống trùng ô) *</label>
                  <select id="mp-slot-select" class="sp-select num" required></select>
                  <span class="sp-hint" id="mp-slot-hint">Chỉ các ô đang trống mới được phép khóa cố định.</span>
                </div>

                <div class="sp-field">
                  <label class="sp-label" for="mp-plate">Biển số xe đăng ký cố định *</label>
                  <input type="text" id="mp-plate" class="sp-input num" placeholder="VD: 51K-868.88" required autocomplete="off">
                </div>
              </div>

              <div class="sp-field-grid">
                <div class="sp-field">
                  <label class="sp-label" for="mp-customer-name">Họ và tên chủ xe *</label>
                  <input type="text" id="mp-customer-name" class="sp-input" value="Phạm Minh Khách" required>
                </div>

                <div class="sp-field">
                  <label class="sp-label" for="mp-customer-phone">Số điện thoại liên hệ *</label>
                  <input type="tel" id="mp-customer-phone" class="sp-input num" value="0906789012" required>
                </div>
              </div>

              <div class="mp-price-banner">
                <div>
                  <div class="mp-price-label" id="mp-price-formula">Đơn giá cơ bản: 1.200.000đ/tháng × 1 tháng</div>
                  <div class="mp-price-total num" id="mp-price-total">1.200.000đ</div>
                </div>
                <span class="mp-discount-tag num" id="mp-discount-badge">Ưu đãi 0%</span>
              </div>

              <button type="submit" class="btn btn-emerald btn-block" id="mp-submit-btn">
                <i data-icon="ticket" data-size="16"></i>
                <span>Đăng ký Vé tháng &amp; Khóa ô cố định</span>
              </button>
            </form>
          </div>

          <!-- Danh sách Gói vé tháng cố định chỗ CỦA RIÊNG TÀI KHOẢN ĐANG ĐĂNG NHẬP -->
          <div class="panel">
            <div class="panel-head">
              <div>
                <h3>Gói vé tháng cố định chỗ của tôi</h3>
                <p>Xem thẻ vé QR định danh và gia hạn gói vé tháng thuộc tài khoản của bạn.</p>
              </div>
              <i data-icon="qr-code" data-size="20"></i>
            </div>

            <div class="mp-list" id="mp-active-list"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. 03 / CÁCH THỨC HOẠT ĐỘNG -->
    <section id="cach-thuc-hoat-dong" class="section" aria-labelledby="how-title">
      <div class="container">
        <div class="section-head">
          <div class="section-title">
            <p class="section-index">03 / QUY TRÌNH ĐẶT CHỖ &amp; VÉ QR</p>
            <h2 id="how-title">4 bước từ chọn ô trống đến kiểm soát cổng</h2>
          </div>
        </div>
        <ol class="steps">
          <li class="step">
            <span class="step-num num">1</span>
            <i data-icon="map-pin" data-size="20"></i>
            <h3>Chọn vị trí ô trống</h3>
            <p>Quan sát sơ đồ 150 ô thuộc 4 phân khu (EV, NT, TH, VIP) và bấm vào một ô màu xanh lá.</p>
          </li>
          <li class="step">
            <span class="step-num num">2</span>
            <i data-icon="calendar" data-size="20"></i>
            <h3>Đặt khung giờ chống trùng lịch</h3>
            <p>Nhập biển số xe, khung giờ vào/ra dự kiến. Hệ thống tự động kiểm tra chống trùng lịch và khóa PCCC tầng hầm B1.</p>
          </li>
          <li class="step">
            <span class="step-num num">3</span>
            <i data-icon="qr-code" data-size="20"></i>
            <h3>Sinh mã vé QR định danh</h3>
            <p>Mã vé QR định danh duy nhất được sinh tức thì trên trình duyệt ngay sau khi xác nhận đặt chỗ.</p>
          </li>
          <li class="step">
            <span class="step-num num">4</span>
            <i data-icon="ticket" data-size="20"></i>
            <h3>Quét Camera QR &amp; Tính phí tự động</h3>
            <p>Tại cổng kiểm soát, camera quét mã QR và hệ thống tự động tính phí theo đơn giá khu, phụ phí quá giờ 1.5x và điện sạc EV.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- 6. 04 / HỖ TRỢ 24/7 -->
    <section id="ho-tro-247" class="section section-subtle" aria-labelledby="support-title">
      <div class="container support-grid">
        <div>
          <p class="section-index">04 / HỖ TRỢ 24/7</p>
          <h2 id="support-title">Cần hỗ trợ khi đang ở bãi?</h2>
          <p class="section-desc">Đội ngũ trực cổng và kỹ thuật trạm sạc hỗ trợ suốt 24 giờ.</p>

          <div class="panel hotline">
            <i data-icon="phone" data-size="20"></i>
            <div>
              <span class="hotline-label">Hotline 24/7</span>
