@model SmartParking_management.Models.ViewModels.SmartParkingViewModel
@{
    var isActive = Model.ActiveTab == "map-tab";
}
<main id="map-tab" class="tab-panel @(isActive ? "active" : "")" @(isActive ? "" : "hidden")>
  <div class="toolbar-card">
    <div class="filter-group" role="group" aria-label="Bộ lọc khu vực và loại xe">
      <select id="filter-zone" aria-label="Lọc theo khu vực">
        <option value="ALL">Tất cả khu vực (A, B, C)</option>
      </select>
      <select id="filter-type" aria-label="Lọc theo loại xe">
        <option value="ALL">Tất cả loại xe</option>
        <option value="CAR">Ô tô (CAR)</option>
        <option value="MOTORBIKE">Xe máy (MOTORBIKE)</option>
      </select>
      <select id="filter-status" aria-label="Lọc theo trạng thái">
        <option value="ALL">Mọi trạng thái</option>
        <option value="AVAILABLE">Còn trống (AVAILABLE)</option>
        <option value="RESERVED">Đã đặt trước (RESERVED)</option>
        <option value="OCCUPIED">Đang có xe (OCCUPIED)</option>
        <option value="MAINTENANCE">Bảo trì (MAINTENANCE)</option>
      </select>
      <input type="search" id="search-slot" placeholder="Tìm mã ô (VD: A-01, C-03)..." aria-label="Tìm mã ô đỗ">
    </div>
    <div class="legend-group" aria-label="Chú thích màu trạng thái">
      <span class="legend-item"><i class="dot dot-available"></i> Trống</span>
      <span class="legend-item"><i class="dot dot-reserved"></i> Đã đặt</span>
      <span class="legend-item"><i class="dot dot-occupied"></i> Có xe</span>
      <span class="legend-item"><i class="dot dot-maintenance"></i> Bảo trì</span>
    </div>
  </div>

  <div id="zones-map-container" class="zones-container">
    <!-- Populated dynamically from Supabase -->
  </div>
</main>
