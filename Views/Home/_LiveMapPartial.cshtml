@model SmartParking_management.Models.ViewModels.SmartParkingViewModel
@{
    var isActive = Model.ActiveTab == "map-tab";
    var total = Math.Max(1, Model.TotalSlots);
    var availCount = Model.AvailableSlots;
    var occCount = Model.Slots.Count(s => s.Status == "OCCUPIED");
    var resCount = Model.Slots.Count(s => s.Status == "RESERVED");
    var maintCount = Model.Slots.Count(s => s.Status == "MAINTENANCE");

    var availRate = (int)Math.Round((double)availCount * 100.0 / total);
    var occRate = (int)Math.Round((double)occCount * 100.0 / total);
    var resRate = (int)Math.Round((double)resCount * 100.0 / total);
    var maintRate = Math.Max(0, 100 - availRate - occRate - resRate);
}
<main id="map-tab" class="tab-panel @(isActive ? "active" : "")" @(isActive ? "" : "hidden")>
  <!-- Operational Filter & Search Command Bar — Baoyu Design & Claude Dashboard -->
  <section class="hero-search-banner" aria-label="Bộ lọc và tìm kiếm vị trí đỗ xe">
    <div class="hero-top-row">
      <div class="hero-copy">
        <div class="hero-badge-row">
          <span class="section-kicker">BẢN ĐỒ Ô ĐỖ THỜI GIAN THỰC</span>
          <span class="live-takeaway-inline" id="live-takeaway-bar">
            Hiện có <strong>@availCount/@Model.TotalSlots</strong> vị trí sẵn sàng đón xe (<strong>@availRate%</strong> công suất trống)
          </span>
        </div>
        <h2>Tra cứu &amp; Điều phối Vị trí Đỗ xe Trực tiếp</h2>
      </div>

      <div class="quick-status-pills" role="group" aria-label="Lọc nhanh theo trạng thái">
        <button type="button" class="status-filter-pill active" data-quick-status="ALL">
          <span>Tất cả</span>
          <b id="pill-count-all">@Model.TotalSlots</b>
        </button>
        <button type="button" class="status-filter-pill" data-quick-status="AVAILABLE">
          <i class="dot dot-available" aria-hidden="true"></i>
          <span>Trống</span>
          <b id="pill-count-avail">@availCount</b>
        </button>
        <button type="button" class="status-filter-pill" data-quick-status="OCCUPIED">
          <i class="dot dot-occupied" aria-hidden="true"></i>
          <span>Có xe</span>
          <b id="pill-count-occ">@occCount</b>
        </button>
        <button type="button" class="status-filter-pill" data-quick-status="RESERVED">
          <i class="dot dot-reserved" aria-hidden="true"></i>
          <span>Đã đặt</span>
          <b id="pill-count-res">@resCount</b>
        </button>
        <button type="button" class="status-filter-pill" data-quick-status="MAINTENANCE">
          <i class="dot dot-maintenance" aria-hidden="true"></i>
          <span>Bảo trì</span>
          <b id="pill-count-maint">@maintCount</b>
        </button>
      </div>
    </div>

    <div class="hero-search-bar" role="group" aria-label="Bộ lọc khu vực và loại xe">
      <div class="search-input-pill">
        <span class="search-icon-left" aria-hidden="true">
          <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input type="search" id="search-slot" placeholder="Tìm mã ô đỗ hoặc biển số (VD: A-01, 51H-889.99)..." aria-label="Tìm mã ô đỗ hoặc biển số">
      </div>

      <select id="filter-zone" aria-label="Lọc theo khu vực">
        <option value="ALL">Tất cả khu vực (A, B, C)</option>
      </select>

      <select id="filter-type" aria-label="Lọc theo loại xe">
        <option value="ALL">Loại xe: Tất cả</option>
        <option value="CAR">Ô tô (CAR)</option>
        <option value="MOTORBIKE">Xe máy (MOTORBIKE)</option>
      </select>

      <select id="filter-status" aria-label="Lọc theo trạng thái">
        <option value="ALL">Mọi trạng thái</option>
        <option value="AVAILABLE">Còn trống (AVAILABLE)</option>
        <option value="RESERVED">Đã đặt trước (RESERVED)</option>
        <option value="OCCUPIED">Đang có xe (OCCUPIED)</option>
        <option value="MAINTENANCE">Bảo trì (MAINTENANCE)</option>
      </select>

      <button type="button" class="btn btn-gold-search" onclick="document.getElementById('search-slot')?.dispatchEvent(new Event('input'))">
        <svg class="ax-icon ax-icon-xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
        </svg>
        <span>Lọc sơ đồ</span>
      </button>
    </div>
  </section>

  <!-- Live Parking Overview & Map Layout -->
  <div class="live-parking-layout">
    <!-- Left Column: Dataviz Telemetry & Zone Breakdown Card -->
    <aside class="live-status-card" aria-label="Trạng thái bãi đỗ trực tiếp">
      <div class="live-card-top">
        <div>
          <h3>Phân bổ Công suất</h3>
          <p class="card-sub-caption">Tỷ lệ khai thác thời gian thực</p>
        </div>
        <span class="pill-ready">
          <span class="pulse-dot" aria-hidden="true"></span>
          Sẵn sàng
        </span>
      </div>

      <div class="live-ring-row">
        <div class="donut-ring-svg-wrap" aria-hidden="true">
          <svg class="donut-svg" viewBox="0 0 100 100">
            <circle class="donut-track" cx="50" cy="50" r="40" fill="none" stroke-width="8"></circle>
            <circle class="donut-arc" id="live-donut-arc" cx="50" cy="50" r="40" fill="none" stroke-width="8" stroke-dasharray="@(Math.Round(availRate * 2.513, 1)) 251.3" stroke-dashoffset="0"></circle>
          </svg>
          <div class="donut-inner">
            <strong id="live-avail-pct">@availRate%</strong>
            <span>Trống</span>
          </div>
        </div>
        <div class="live-count-highlight">
          <strong id="live-avail-count">@availCount</strong>
          <span>Chỗ trống sẵn sàng</span>
          <small id="live-total-caption">Trên tổng @Model.TotalSlots vị trí đỗ</small>
        </div>
      </div>

      <!-- Dataviz 2px-Gapped Stacked Composition Bar -->
      <div class="composition-block">
        <div class="composition-header">
          <span>Cơ cấu trạng thái toàn bãi</span>
          <span id="live-occ-summary">@(occCount + resCount) bận / @Model.TotalSlots ô</span>
        </div>
        <div class="stacked-bar-2px" id="live-composition-bar" role="img" aria-label="Thanh tỷ lệ trạng thái ô đỗ">
          <span class="stack-seg seg-avail" style="width: @(Math.Max(availCount > 0 ? 6 : 0, availRate))%" title="Trống: @availCount ô"></span>
          <span class="stack-seg seg-occ" style="width: @(Math.Max(occCount > 0 ? 6 : 0, occRate))%" title="Có xe: @occCount ô"></span>
          <span class="stack-seg seg-res" style="width: @(Math.Max(resCount > 0 ? 6 : 0, resRate))%" title="Đã đặt: @resCount ô"></span>
          <span class="stack-seg seg-maint" style="width: @(Math.Max(maintCount > 0 ? 6 : 0, maintRate))%" title="Bảo trì: @maintCount ô"></span>
        </div>
      </div>

      <div class="live-zone-bars">
        <p class="live-sub-label">Trạng thái trực tiếp theo khu vực:</p>
        <div id="live-zone-bars-list" class="zone-bars-stack">
          @foreach (var z in Model.Zones)
          {
              var zoneSlots = Model.Slots.Where(s => s.ZoneId == z.Id).ToList();
              var freeCount = zoneSlots.Count(s => s.Status == "AVAILABLE");
              var totalCount = Math.Max(1, zoneSlots.Count);
              var pct = (int)Math.Round((double)freeCount * 100.0 / totalCount);
              <div class="mini-zone-row">
                <div class="mini-zone-text">
                  <strong>@z.ZoneCode</strong>
                  <span>@(freeCount > 0 ? $"{freeCount}/{totalCount} trống" : "Đầy")</span>
                </div>
                <div class="mini-zone-bar">
                  <span class="seg-green" style="width: @(pct)%"></span>
                  <span class="seg-gold" style="width: @(Math.Max(0, 100 - pct))%"></span>
                </div>
              </div>
          }
        </div>
      </div>

      <div class="legend-group" aria-label="Chú thích màu trạng thái">
        <span class="legend-item"><i class="dot dot-available"></i> Trống (<b id="lg-avail">@availCount</b>)</span>
        <span class="legend-item"><i class="dot dot-occupied"></i> Có xe (<b id="lg-occ">@occCount</b>)</span>
        <span class="legend-item"><i class="dot dot-reserved"></i> Đã đặt (<b id="lg-res">@resCount</b>)</span>
        <span class="legend-item"><i class="dot dot-maintenance"></i> Bảo trì (<b id="lg-maint">@maintCount</b>)</span>
      </div>
    </aside>

    <!-- Right Column: Interactive Parking Zones Map -->
    <div id="zones-map-container" class="zones-container">
      <!-- Populated dynamically from Supabase -->
    </div>
  </div>
</main>
