@model SmartParking_management.Models.ViewModels.SmartParkingViewModel
@{
    var availPct = Model.TotalSlots > 0
        ? (int)Math.Round((double)Model.AvailableSlots * 100.0 / Model.TotalSlots)
        : 62;
    var busyPct = Model.TotalSlots > 0
        ? (int)Math.Round((double)Model.BusySlots * 100.0 / Model.TotalSlots)
        : 31;
}

<!-- Global KPI Scorecard Strip — Claude Dashboard & Dataviz Rules -->
<section class="kpi-strip" aria-label="Chỉ số nhanh bãi xe">
  <article class="kpi-card">
    <div class="kpi-header">
      <span class="kpi-label">
        <i class="kpi-swatch swatch-series-1" aria-hidden="true"></i>
        <span>Tổng công suất ô đỗ</span>
      </span>
      <span class="kpi-icon" aria-hidden="true">
        <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="3"></rect>
          <path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path>
        </svg>
      </span>
    </div>
    <div class="kpi-value-row">
      <div class="kpi-value" id="kpi-total-slots">@Model.TotalSlots</div>
      <span class="kpi-delta-pill">100% quy mô</span>
    </div>
    <div class="kpi-microbar" aria-hidden="true">
      <span class="microbar-fill fill-series-1" style="width: 100%"></span>
    </div>
    <div class="kpi-foot" id="kpi-zones-summary">@Model.Zones.Count khu vực (Khu A, B, C)</div>
  </article>

  <article class="kpi-card kpi-available">
    <div class="kpi-header">
      <span class="kpi-label">
        <i class="kpi-swatch swatch-series-3" aria-hidden="true"></i>
        <span>Chỗ trống sẵn sàng</span>
      </span>
      <span class="kpi-icon kpi-icon-emerald" aria-hidden="true">
        <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
      </span>
    </div>
    <div class="kpi-value-row">
      <div class="kpi-value" id="kpi-avail-slots">@Model.AvailableSlots</div>
      <span class="kpi-delta-pill delta-good" id="kpi-avail-pct">@availPct% trống</span>
    </div>
    <div class="kpi-microbar" aria-hidden="true">
      <span class="microbar-fill fill-series-3" id="kpi-avail-bar" style="width: @(availPct)%"></span>
    </div>
    <div class="kpi-foot" id="kpi-avail-detail">Đồng bộ thời gian thực</div>
  </article>

  <article class="kpi-card kpi-occupied">
    <div class="kpi-header">
      <span class="kpi-label">
        <i class="kpi-swatch swatch-series-2" aria-hidden="true"></i>
        <span>Đang đỗ &amp; Đặt trước</span>
      </span>
      <span class="kpi-icon kpi-icon-amber" aria-hidden="true">
        <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
          <circle cx="7" cy="17" r="2"></circle>
          <path d="M9 17h6"></path>
          <circle cx="17" cy="17" r="2"></circle>
        </svg>
      </span>
    </div>
    <div class="kpi-value-row">
      <div class="kpi-value" id="kpi-busy-slots">@Model.BusySlots</div>
      <span class="kpi-delta-pill delta-warn" id="kpi-busy-pct">@busyPct% khai thác</span>
    </div>
    <div class="kpi-microbar" aria-hidden="true">
      <span class="microbar-fill fill-series-2" id="kpi-busy-bar" style="width: @(busyPct)%"></span>
    </div>
    <div class="kpi-foot" id="kpi-busy-detail">Kiểm soát tự động qua QR</div>
  </article>

  <article class="kpi-card kpi-revenue">
    <div class="kpi-header">
      <span class="kpi-label">
        <i class="kpi-swatch swatch-series-7" aria-hidden="true"></i>
        <span>Tổng doanh thu (VNĐ)</span>
      </span>
      <span class="kpi-icon" aria-hidden="true">
        <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="5" width="20" height="14" rx="2"></rect>
          <line x1="2" y1="10" x2="22" y2="10"></line>
        </svg>
      </span>
    </div>
    <div class="kpi-value-row">
      <div class="kpi-value" id="kpi-revenue-total">@Model.TotalRevenue.ToString("N0") ₫</div>
      <span class="kpi-delta-pill">Phiên hoàn tất</span>
    </div>
    <div class="kpi-microbar" aria-hidden="true">
      <span class="microbar-fill fill-series-7" style="width: 78%"></span>
    </div>
    <div class="kpi-foot" id="kpi-sessions-count">@Model.Sessions.Count(s => s.Status == "COMPLETED") lượt đã thanh toán</div>
  </article>
</section>

<!-- TAB 1: LIVE PARKING MAP (Home/Index) -->
@await Html.PartialAsync("~/Views/Home/_LiveMapPartial.cshtml", Model)

<!-- TAB 2: ADVANCE BOOKING (Booking/Book) -->
@await Html.PartialAsync("~/Views/Booking/Book.cshtml", Model)

<!-- TAB 3: QR CHECK-IN / CHECK-OUT & FEE ENGINE (CheckInOut/Index) -->
@await Html.PartialAsync("~/Views/CheckInOut/Index.cshtml", Model)

<!-- TAB 4: VEHICLE REGISTRATION (Vehicle/Index) -->
@await Html.PartialAsync("~/Views/Vehicle/Index.cshtml", Model)

<!-- TAB 5: PARKING SLOT & ZONE MANAGEMENT (ParkingSlot/Index) -->
@await Html.PartialAsync("~/Views/ParkingSlot/Index.cshtml", Model)

<!-- TAB 6: HISTORY & INVOICES (Invoice/Index) -->
@await Html.PartialAsync("~/Views/Invoice/Index.cshtml", Model)

<!-- TAB 7: ANALYTICS & ADMIN DASHBOARD (Admin/Index) -->
@await Html.PartialAsync("~/Views/Admin/Index.cshtml", Model)
