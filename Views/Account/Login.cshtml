@model List<SmartParking_management.Models.User>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập Hệ thống — SmartPark</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <style>
    :root {
      --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --bg: #F3F6FB;
      --surface: #FFFFFF;
      --subtle: #E9EFF8;
      --border: #CBD5E1;
      --border-strong: #94A3B8;
      --text: #0F172A;
      --text-2: #334155;
      --text-3: #64748B;
      --navy-950: #08172E;
      --navy-900: #0D2549;
      --navy-800: #16396D;
      --accent: #2563EB;
      --accent-hover: #1D4ED8;
      --accent-bg: #EFF6FF;
      --accent-border: #BFDBFE;
      --success: #16A34A;
      --success-bg: #F0FDF4;
      --success-border: #BBF7D0;
      --danger: #DC2626;
      --danger-bg: #FEF2F2;
      --danger-border: #FECACA;
      --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    }

    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: var(--font);
      font-size: 14.5px;
      line-height: 1.55;
      color: var(--text);
      background: linear-gradient(135deg, var(--navy-950) 0%, var(--navy-900) 55%, var(--navy-800) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      -webkit-font-smoothing: antialiased;
    }

    .auth-card {
      width: 100%;
      max-width: 460px;
      background: var(--surface);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 12px;
      padding: 28px;
      box-shadow: 0 20px 44px rgba(4, 12, 28, 0.38);
      animation: cardEnter 0.42s var(--ease-out) both;
    }

    @@keyframes cardEnter {
      from { opacity: 0; transform: translateY(14px) scale(0.99); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .brand-bar {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--navy-950);
      margin-bottom: 18px;
    }
    .brand-mark {
      width: 32px;
      height: 32px;
      border-radius: 7px;
      background: var(--accent);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 15px;
    }
    .brand-name { font-weight: 700; font-size: 15.5px; letter-spacing: -0.01em; color: var(--navy-950); }
    .brand-badge {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--accent-hover);
      background: var(--accent-bg);
      border: 1px solid var(--accent-border);
      padding: 3px 9px;
      border-radius: 999px;
      margin-bottom: 18px;
    }

    .auth-header h1 {
      margin: 0 0 6px;
      font-size: 21px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--navy-950);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .auth-header h1 svg {
      color: var(--accent);
    }
    .auth-header p {
      margin: 0 0 20px;
      font-size: 13.5px;
      color: var(--text-2);
    }

    .form-group {
      margin-bottom: 14px;
    }
    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 6px;
    }
    .input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .input-wrap input {
      width: 100%;
      height: 42px;
      padding: 0 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      font-family: var(--font);
      font-size: 14px;
      color: var(--text);
      transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
    }
    .input-wrap input:hover {
      border-color: var(--border-strong);
    }
    .input-wrap input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }
    .input-wrap input.flash-fill {
      background-color: var(--accent-bg);
      border-color: var(--accent);
    }

    .toggle-pw {
      position: absolute;
      right: 8px;
      height: 28px;
      padding: 0 8px;
      border: 0;
      border-radius: 6px;
      background: transparent;
      color: var(--text-3);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
    }
    .toggle-pw:hover { color: var(--text); background: var(--subtle); }

    .alert-box {
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 14px;
      border: 1px solid;
      display: none;
      animation: fadeIn 0.22s ease;
    }
    .alert-box.is-error {
      display: block;
      background: var(--danger-bg);
      border-color: var(--danger-border);
      color: var(--danger);
    }
    .alert-box.is-success {
      display: block;
      background: var(--success-bg);
      border-color: var(--success-border);
      color: var(--success);
    }

    @@keyframes fadeIn {
      from { opacity: 0; transform: translateY(-4px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .btn-submit {
      width: 100%;
      height: 44px;
      border: 1px solid var(--accent);
      border-radius: 8px;
      background: var(--accent);
      color: #fff;
      font-family: var(--font);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.18s var(--ease-out);
      margin-top: 4px;
    }
    .btn-submit:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
      transform: translateY(-1px);
    }
    .btn-submit:active {
      transform: translateY(0);
    }

    /* Quick Demo Accounts Box */
    .quick-demo-box {
      margin-top: 20px;
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--bg);
    }
    .quick-demo-title {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--navy-900);
      margin-bottom: 12px;
    }
    .role-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }
    .role-chip {
      height: 34px;
      padding: 0 12px;
      border: 1px solid var(--border);
      border-radius: 7px;
      background: var(--surface);
      color: var(--text-2);
      font-family: var(--font);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.18s var(--ease-out);
    }
    .role-chip:hover {
      border-color: var(--accent);
      color: var(--accent-hover);
      transform: translateY(-1.5px);
    }
    .role-chip.is-active {
      background: var(--navy-900);
      border-color: var(--navy-900);
      color: #fff;
      font-weight: 600;
    }
    .quick-demo-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 12.5px;
      color: var(--text-2);
    }
    .pw-pill {
      display: inline-block;
      padding: 1px 8px;
      border: 1px solid var(--border-strong);
      border-radius: 999px;
      background: var(--surface);
      color: var(--text);
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      font-size: 12px;
    }
    .selected-hint {
      font-size: 12px;
      color: var(--accent);
      font-weight: 500;
    }

    .auth-footer {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
    }
    .auth-footer a {
      text-decoration: none;
      font-weight: 600;
      transition: color 0.15s ease;
    }
    .link-primary { color: var(--accent); }
    .link-primary:hover { text-decoration: underline; }
    .link-muted { color: var(--text-2); font-weight: 500; }
    .link-muted:hover { color: var(--text); }
  </style>
</head>
<body>
  <main class="auth-card">
    <div style="display:flex; align-items:center; justify-content:space-between;">
      <a href="/" class="brand-bar">
        <span class="brand-mark">P</span>
        <span class="brand-name">SmartPark</span>
      </a>
      <span class="brand-badge">SMARTPARK ACCESS</span>
    </div>

    <div class="auth-header">
      <h1>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Đăng nhập Hệ thống SmartPark</span>
      </h1>
      <p>Nhập tên đăng nhập của bạn hoặc chọn nhanh tài khoản mẫu bên dưới</p>
    </div>

    <div id="login-alert" class="alert-box" role="alert"></div>

    <form id="login-form" novalidate>
      <div class="form-group">
        <label for="login-username">Tên đăng nhập *</label>
        <div class="input-wrap">
          <input type="text" id="login-username" name="username" autocomplete="username" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="Nhập tên đăng nhập" value="admin" required>
        </div>
      </div>

      <div class="form-group">
        <label for="login-password">Mật khẩu *</label>
        <div class="input-wrap">
          <input type="password" id="login-password" name="password" autocomplete="current-password" placeholder="Nhập mật khẩu" value="123456" required style="padding-right: 56px;">
          <button type="button" class="toggle-pw" id="toggle-pw-btn" aria-label="Hiện hoặc ẩn mật khẩu">Hiện</button>
        </div>
      </div>

      <button type="submit" class="btn-submit">
        <span>Đăng nhập vào Hệ thống</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
    </form>

    <!-- Khối Tài khoản Mẫu Kiểm thử Nhanh (6 Role chuẩn) -->
    <section class="quick-demo-box" aria-label="Tài khoản mẫu kiểm thử nhanh">
      <div class="quick-demo-title">
        <span>TÀI KHOẢN MẪU KIỂM THỬ NHANH:</span>
      </div>

      <div class="role-chips" role="group" aria-label="Chọn vai trò mẫu">
        <button type="button" class="role-chip is-active" data-demo-user="admin" data-demo-role="ADMIN" data-demo-label="Admin">Admin</button>
        <button type="button" class="role-chip" data-demo-user="manager" data-demo-role="MANAGER" data-demo-label="Quản Lý Ca">Quản Lý Ca</button>
        <button type="button" class="role-chip" data-demo-user="gate_staff" data-demo-role="GATE_STAFF" data-demo-label="NV Trực Cổng">NV Trực Cổng</button>
        <button type="button" class="role-chip" data-demo-user="accountant" data-demo-role="ACCOUNTANT" data-demo-label="Kế Toán">Kế Toán</button>
        <button type="button" class="role-chip" data-demo-user="technician" data-demo-role="TECHNICIAN" data-demo-label="Kỹ Thuật Viên">Kỹ Thuật Viên</button>
        <button type="button" class="role-chip" data-demo-user="customer" data-demo-role="CUSTOMER" data-demo-label="Khách Hàng">Khách Hàng</button>
      </div>

      <div class="quick-demo-meta">
        <span>Mật khẩu chung: <code class="pw-pill">123456</code></span>
      </div>
    </section>

    <div class="auth-footer">
      <a href="/Account/Register" class="link-primary">Chưa có tài khoản? Đăng ký</a>
      <a href="/" class="link-muted">← Về Trang chủ Bãi xe</a>
    </div>
  </main>

  <script>
    (() => {
      const DEMO_ACCOUNTS = {
        admin:      { username: 'admin',      password: '123456', role: 'ADMIN',      roleLabel: 'Quản Trị Viên', fullName: 'Nguyễn Phước Sang (Admin)',       target: '/?login=1' },
        manager:    { username: 'manager',    password: '123456', role: 'MANAGER',    roleLabel: 'Quản Lý Ca',    fullName: 'Võ Việt Thắng (Quản Lý Ca)',      target: '/?login=1' },
        gate_staff: { username: 'gate_staff', password: '123456', role: 'GATE_STAFF', roleLabel: 'NV Trực Cổng',  fullName: 'Đoàn Tiến Đạt (NV Trực Cổng)',    target: '/?login=1' },
        accountant: { username: 'accountant', password: '123456', role: 'ACCOUNTANT', roleLabel: 'Kế Toán',       fullName: 'Lê Thị Thu Ngân (Kế Toán)',        target: '/?login=1' },
        technician: { username: 'technician', password: '123456', role: 'TECHNICIAN', roleLabel: 'Kỹ Thuật Viên', fullName: 'Trần Kỹ Thuật (Kỹ Thuật Viên)',   target: '/?login=1' },
        customer:   { username: 'customer',   password: '123456', role: 'CUSTOMER',   roleLabel: 'Khách Hàng',    fullName: 'Phạm Minh Khách (Khách Hàng)',    target: '/?login=1' }
      };

      const userInput = document.getElementById('login-username');
      const passInput = document.getElementById('login-password');
      const alertBox  = document.getElementById('login-alert');
      const chips     = document.querySelectorAll('.role-chip');

      // Show message if redirected after successful registration
      const params = new URLSearchParams(window.location.search);
      if (params.get('registered') === '1') {
        const regUser = params.get('username') || '';
        if (regUser) userInput.value = regUser;
        passInput.value = '';
        chips.forEach((c) => c.classList.remove('is-active'));
        alertBox.className = 'alert-box is-success';
        alertBox.textContent = 'Đăng ký tài khoản thành công! Vui lòng nhập mật khẩu để đăng nhập.';
      }

      // Toggle password visibility
      document.getElementById('toggle-pw-btn')?.addEventListener('click', (e) => {
        const isPw = passInput.type === 'password';
        passInput.type = isPw ? 'text' : 'password';
        e.currentTarget.textContent = isPw ? 'Ẩn' : 'Hiện';
      });

      // Click a quick demo role button -> autofill username + 123456
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.remove('is-active'));
          chip.classList.add('is-active');

          const u = chip.getAttribute('data-demo-user') || 'admin';
          userInput.value = u;
          passInput.value = '123456';
          alertBox.className = 'alert-box';

          [userInput, passInput].forEach((el) => {
            el.classList.remove('flash-fill');
            void el.offsetWidth;
            el.classList.add('flash-fill');
            setTimeout(() => el.classList.remove('flash-fill'), 450);
          });
        });
      });

      userInput.addEventListener('input', () => {
        const val = userInput.value.trim().toLowerCase();
        chips.forEach((c) => {
          c.classList.toggle('is-active', c.getAttribute('data-demo-user') === val);
        });
      });

      // Handle Login Submit
      document.getElementById('login-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const u = userInput.value.trim().toLowerCase();
        const p = passInput.value;

        if (!u || !p) {
          alertBox.className = 'alert-box is-error';
          alertBox.textContent = 'Vui lòng nhập đầy đủ Tên đăng nhập và Mật khẩu.';
          return;
        }

        // 1. Check built-in 6 role demo accounts
        if (DEMO_ACCOUNTS[u]) {
          if (p !== DEMO_ACCOUNTS[u].password) {
            alertBox.className = 'alert-box is-error';
            alertBox.textContent = `Mật khẩu của tài khoản mẫu "${u}" là 123456.`;
            return;
          }
          const acct = DEMO_ACCOUNTS[u];
          localStorage.setItem('smartpark_auth_user', JSON.stringify({
            username: acct.username,
            fullName: acct.fullName,
            role: acct.role,
            roleLabel: acct.roleLabel
          }));
          window.location.href = acct.target;
          return;
        }

        // 2. Check registered accounts in localStorage
        let customUsers = [];
        try {
          customUsers = JSON.parse(localStorage.getItem('smartpark_registered_users') || '[]');
        } catch {}

        const foundCustom = customUsers.find((item) => item.username.toLowerCase() === u);
        if (foundCustom) {
          if (foundCustom.password !== p) {
            alertBox.className = 'alert-box is-error';
            alertBox.textContent = 'Mật khẩu không chính xác. Vui lòng kiểm tra lại.';
            return;
          }
          localStorage.setItem('smartpark_auth_user', JSON.stringify({
            username: foundCustom.username,
            fullName: `${foundCustom.fullName} (Khách Hàng)`,
            roleLabel: 'Khách Hàng',
            gender: foundCustom.gender,
            phone: foundCustom.phone,
            role: 'CUSTOMER'
          }));
          window.location.href = '/?login=1';
          return;
        }

        alertBox.className = 'alert-box is-error';
        alertBox.textContent = `Không tìm thấy tên đăng nhập "${u}". Hãy chọn 1 trong 6 tài khoản mẫu bên dưới hoặc đăng ký mới.`;
      });
    })();
  </script>
</body>
</html>
