@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng ký Tài khoản — SmartPark</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <style>
    :root {
      --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --bg: #F3F6FB;
      --surface: #FFFFFF;
      --subtle: #E9EFF8;
      --border: #CBD5E1;
      --border-strong: #94A3B8;
      --text: #0F172A;
      --text-2: #334155;
      --text-3: #64748B;
      --navy-950: #08172E;
      --navy-900: #0D2549;
      --navy-800: #16396D;
      --accent: #2563EB;
      --accent-hover: #1D4ED8;
      --accent-bg: #EFF6FF;
      --accent-border: #BFDBFE;
      --danger: #DC2626;
      --danger-bg: #FEF2F2;
      --danger-border: #FECACA;
      --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    }

    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: var(--font);
      font-size: 14.5px;
      line-height: 1.55;
      color: var(--text);
      background: linear-gradient(135deg, var(--navy-950) 0%, var(--navy-900) 55%, var(--navy-800) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      -webkit-font-smoothing: antialiased;
    }

    .auth-card {
      width: 100%;
      max-width: 520px;
      background: var(--surface);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 12px;
      padding: 28px;
      box-shadow: 0 20px 44px rgba(4, 12, 28, 0.38);
      animation: cardEnter 0.42s var(--ease-out) both;
    }

    @@keyframes cardEnter {
      from { opacity: 0; transform: translateY(14px) scale(0.99); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .brand-bar {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--navy-950);
      margin-bottom: 18px;
    }
    .brand-mark {
      width: 32px;
      height: 32px;
      border-radius: 7px;
      background: var(--accent);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 15px;
    }
    .brand-name { font-weight: 700; font-size: 15.5px; letter-spacing: -0.01em; color: var(--navy-950); }
    .brand-badge {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--accent-hover);
      background: var(--accent-bg);
      border: 1px solid var(--accent-border);
      padding: 3px 9px;
      border-radius: 999px;
      margin-bottom: 18px;
    }

    .auth-header h1 {
      margin: 0 0 6px;
      font-size: 21px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--navy-950);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .auth-header h1 svg {
      color: var(--accent);
    }
    .auth-header p {
      margin: 0 0 20px;
      font-size: 13.5px;
      color: var(--text-2);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .form-group {
      margin-bottom: 14px;
    }
    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 6px;
    }
    .form-group input,
    .form-group select {
      width: 100%;
      height: 42px;
      padding: 0 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      font-family: var(--font);
      font-size: 14px;
      color: var(--text);
      transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .form-group input:hover,
    .form-group select:hover {
      border-color: var(--border-strong);
    }
    .form-group input:focus,
    .form-group select:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    /* Gender segmented selector */
    .gender-group {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      height: 42px;
      padding: 3px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg);
    }
    .gender-opt {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      border-radius: 6px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--text-2);
      user-select: none;
      transition: all 0.16s var(--ease-out);
    }
    .gender-opt input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }
    .gender-opt:has(input:checked) {
      background: var(--navy-900);
      color: #FFFFFF;
      font-weight: 600;
      border: 1px solid var(--navy-900);
    }

    .alert-box {
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 14px;
      border: 1px solid var(--danger-border);
      background: var(--danger-bg);
      color: var(--danger);
      display: none;
    }
    .alert-box.is-visible { display: block; }

    .btn-submit {
      width: 100%;
      height: 44px;
      border: 1px solid var(--accent);
      border-radius: 8px;
      background: var(--accent);
      color: #fff;
      font-family: var(--font);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.18s var(--ease-out);
      margin-top: 6px;
    }
    .btn-submit:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
      transform: translateY(-1px);
    }

    .auth-footer {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
    }
    .auth-footer a { text-decoration: none; font-weight: 600; }
    .link-primary { color: var(--accent); }
    .link-primary:hover { text-decoration: underline; }
    .link-muted { color: var(--text-2); font-weight: 500; }
    .link-muted:hover { color: var(--text); }

    @@media (max-width: 520px) {
      .form-row { grid-template-columns: 1fr; gap: 0; }
    }
  </style>
</head>
<body>
  <main class="auth-card">
    <div style="display:flex; align-items:center; justify-content:space-between;">
      <a href="/" class="brand-bar">
        <span class="brand-mark">P</span>
        <span class="brand-name">SmartPark</span>
      </a>
      <span class="brand-badge">SMARTPARK MEMBER</span>
    </div>

    <div class="auth-header">
      <h1>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <line x1="19" x2="19" y1="8" y2="14"></line>
          <line x1="22" x2="16" y1="11" y2="11"></line>
        </svg>
        <span>Đăng ký Tài khoản Khách hàng</span>
      </h1>
      <p>Tạo tài khoản để đặt chỗ đỗ xe trực tuyến và quản lý vé tháng nhanh chóng</p>
    </div>

    <div id="reg-alert" class="alert-box" role="alert"></div>

    <form id="register-form" novalidate>
      <div class="form-row">
        <div class="form-group">
          <label for="reg-fullname">Họ và tên *</label>
          <input type="text" id="reg-fullname" name="full_name" autocomplete="name" required placeholder="Nguyễn Văn A">
        </div>

        <div class="form-group">
          <label>Giới tính *</label>
          <div class="gender-group" role="radiogroup" aria-label="Giới tính">
            <label class="gender-opt">
              <input type="radio" name="gender" value="Nam" checked>
              <span>Nam</span>
            </label>
            <label class="gender-opt">
              <input type="radio" name="gender" value="Nữ">
              <span>Nữ</span>
            </label>
            <label class="gender-opt">
              <input type="radio" name="gender" value="Khác">
              <span>Khác</span>
            </label>
          </div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="reg-username">Tên đăng nhập *</label>
          <input type="text" id="reg-username" name="username" autocomplete="username" autocorrect="off" autocapitalize="off" spellcheck="false" required placeholder="nguyenvana">
        </div>

        <div class="form-group">
          <label for="reg-phone">Số điện thoại *</label>
          <input type="tel" id="reg-phone" name="phone" autocomplete="tel" inputmode="numeric" required placeholder="0901234567" style="font-variant-numeric: tabular-nums;">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="reg-password">Mật khẩu *</label>
          <input type="password" id="reg-password" name="password" autocomplete="new-password" minlength="6" required placeholder="Tối thiểu 6 ký tự">
        </div>

        <div class="form-group">
          <label for="reg-confirm-password">Xác nhận lại mật khẩu *</label>
          <input type="password" id="reg-confirm-password" name="confirm_password" autocomplete="new-password" minlength="6" required placeholder="Nhập lại mật khẩu">
        </div>
      </div>

      <button type="submit" class="btn-submit">
        <span>Hoàn tất Đăng ký</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
    </form>

    <div class="auth-footer">
      <a href="/Account/Login" class="link-primary">Đã có tài khoản? Đăng nhập</a>
      <a href="/" class="link-muted">← Về Trang chủ Bãi xe</a>
    </div>
  </main>

  <script>
    (() => {
      const form = document.getElementById('register-form');
      const alertBox = document.getElementById('reg-alert');

      function showError(msg) {
        alertBox.textContent = msg;
        alertBox.classList.add('is-visible');
      }

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        alertBox.classList.remove('is-visible');

        const fullName = document.getElementById('reg-fullname').value.trim();
        const gender = form.querySelector('input[name="gender"]:checked')?.value || 'Nam';
        const username = document.getElementById('reg-username').value.trim();
        const phone = document.getElementById('reg-phone').value.trim();
        const password = document.getElementById('reg-password').value;
        const confirmPw = document.getElementById('reg-confirm-password').value;

        if (!fullName) return showError('Vui lòng nhập họ và tên.');
        if (!username || username.length < 3) return showError('Tên đăng nhập cần có ít nhất 3 ký tự.');
        if (!/^0\d{9}$/.test(phone)) return showError('Số điện thoại cần gồm 10 chữ số bắt đầu bằng số 0.');
        if (!password || password.length < 6) return showError('Mật khẩu cần có tối thiểu 6 ký tự.');
        if (password !== confirmPw) return showError('Mật khẩu xác nhận không khớp. Vui lòng nhập lại.');

        const reserved = ['admin', 'manager', 'gate_staff', 'accountant', 'technician', 'customer'];
        if (reserved.includes(username.toLowerCase())) {
          return showError('Tên đăng nhập này đã thuộc hệ thống mẫu. Vui lòng chọn tên khác.');
        }

        let list = [];
        try {
          list = JSON.parse(localStorage.getItem('smartpark_registered_users') || '[]');
        } catch {}

        if (list.some((u) => u.username.toLowerCase() === username.toLowerCase())) {
          return showError('Tên đăng nhập này đã được đăng ký trước đó.');
        }

        list.push({
          username,
          fullName,
          gender,
          phone,
          password,
          role: 'CUSTOMER',
          createdAt: new Date().toISOString()
        });
        localStorage.setItem('smartpark_registered_users', JSON.stringify(list));

        window.location.href = `/Account/Login?registered=1&username=${encodeURIComponent(username)}`;
      });
    })();
  </script>
</body>
</html>
