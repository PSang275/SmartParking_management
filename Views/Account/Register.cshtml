@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" data-theme="light" data-astryx-theme="neutral">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <title>Đăng ký Tài khoản — SmartPark</title>
  <link rel="stylesheet" href="/lib/astryx/fonts.css" asp-append-version="true">
  <link rel="stylesheet" href="/lib/astryx/astryx.css" asp-append-version="true">
  <link rel="stylesheet" href="/lib/astryx/theme-neutral.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/styles.css" asp-append-version="true">
</head>
<body class="astryx-root" style="display:flex; align-items:center; justify-content:center; min-height:100vh; padding:1.5rem;">
  <main class="card" style="max-width:520px; width:100%;">
    <div class="card-header">
      <span class="topbar-eyebrow">SMARTPARK MEMBER</span>
      <h3 style="display:flex; align-items:center; gap:0.5rem; margin-top:0.35rem;">
        <svg class="ax-icon" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <line x1="20" y1="8" x2="20" y2="14"></line>
          <line x1="23" y1="11" x2="17" y2="11"></line>
        </svg>
        <span>Đăng ký Tài khoản Khách hàng</span>
      </h3>
      <p>Tạo tài khoản để đặt chỗ đỗ xe trực tuyến và quản lý phương tiện nhanh chóng</p>
    </div>
    <form action="/Account/Login" method="get" class="modern-form">
      <div class="field">
        <label for="reg-fullname">Họ và tên *</label>
        <input type="text" id="reg-fullname" name="full_name" autocomplete="name" required placeholder="Nguyễn Văn A">
      </div>
      <div class="field-row">
        <div class="field">
          <label for="reg-username">Tên đăng nhập *</label>
          <input type="text" id="reg-username" name="username" autocomplete="username" autocorrect="off" autocapitalize="off" spellcheck="false" required placeholder="nguyenvana">
        </div>
        <div class="field">
          <label for="reg-phone">Số điện thoại *</label>
          <input type="tel" id="reg-phone" name="phone" autocomplete="tel" required placeholder="0901234567">
        </div>
      </div>
      <div class="field">
        <label for="reg-password">Mật khẩu *</label>
        <input type="password" id="reg-password" name="password" autocomplete="new-password" minlength="6" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Hoàn tất Đăng ký</button>
    </form>
    <hr class="divider">
    <div style="display:flex; justify-content:space-between; font-size:0.875rem;">
      <a href="/Account/Login" style="color:var(--brand-color); font-weight:700; text-decoration:none;">Đã có tài khoản? Đăng nhập</a>
      <a href="/" style="color:var(--text-muted); font-weight:600; text-decoration:none;">← Về Trang chủ Bãi xe</a>
    </div>
  </main>
</body>
</html>
