@model SmartParking_management.Models.ViewModels.SmartParkingViewModel
@{
    var isActive = Model.ActiveTab == "history-tab";
}
<section id="history-tab" class="tab-panel @(isActive ? "active" : "")" @(isActive ? "" : "hidden")>
  <div class="card">
    <div class="card-header card-header-inline">
      <div>
        <h3>Lịch sử Quá trình Xe Vào / Ra &amp; Hóa đơn</h3>
        <p>Tra cứu toàn bộ phiên gửi xe theo biển số, mã vé QR hoặc trạng thái thanh toán</p>
      </div>
      <div class="filter-group">
        <input type="search" id="history-search" placeholder="Tìm biển số, mã QR, mã ô..." aria-label="Tìm lịch sử">
        <select id="history-status-filter" aria-label="Lọc trạng thái phiên">
          <option value="ALL">Tất cả phiên</option>
          <option value="ACTIVE">Đang đỗ trong bãi</option>
          <option value="COMPLETED">Đã thanh toán</option>
        </select>
      </div>
    </div>

    <div tabindex="0" role="region" aria-labelledby="history-table-caption" class="table-wrapper">
      <table id="history-table">
        <caption id="history-table-caption" class="sr-only">Bảng lịch sử lượt xe vào ra và phí đỗ xe</caption>
        <thead>
          <tr>
            <th>Mã QR Vé</th>
            <th>Biển số &amp; Ô</th>
            <th>Giờ vào / Giờ ra</th>
            <th>Thời lượng</th>
            <th>Tổng phí</th>
            <th>Trạng thái</th>
            <th>Chi tiết</th>
          </tr>
        </thead>
        <tbody id="history-tbody"></tbody>
      </table>
    </div>
  </div>
</section>
