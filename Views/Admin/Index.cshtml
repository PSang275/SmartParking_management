@model SmartParking_management.Models.ViewModels.SmartParkingViewModel
@{
    var isActive = Model.ActiveTab == "dashboard-tab";
}
<section id="dashboard-tab" class="tab-panel @(isActive ? "active" : "")" @(isActive ? "" : "hidden")>
  <div class="dashboard-grid">
    <div class="card">
      <div class="card-header card-header-inline">
        <div>
          <h3>Doanh thu &amp; Công suất theo Khu vực (A / B / C)</h3>
          <p>So sánh mức độ lấp đầy và tổng thu thực tế trên cùng một thang đo chuẩn (di chuột để xem chi tiết)</p>
        </div>
        <span class="badge badge-cpp">Toàn thời gian</span>
      </div>
      <div id="zone-analytics-bars" class="analytics-bars"></div>
    </div>

    <div class="card">
      <div class="card-header card-header-inline">
        <div>
          <h3>Phân bổ Trạng thái Ô đỗ &amp; Phương tiện</h3>
          <p>Tỷ lệ khai thác bãi xe thời gian thực theo 4 nhóm trạng thái</p>
        </div>
        <span class="badge badge-cpp">Trực tiếp</span>
      </div>
      <div id="status-breakdown-box" class="breakdown-list"></div>
    </div>
  </div>

  <div class="card" style="margin-top: 1.15rem;">
    <div class="card-header">
      <h3>Quy chuẩn Vận hành &amp; Thu phí Tự động SmartPark</h3>
      <p>Hệ thống quản lý vị trí đỗ xe, đặt chỗ trước và kiểm soát vé QR theo tiêu chuẩn minh bạch</p>
    </div>
    <div class="arch-cards">
      <div class="arch-item">
        <span class="badge badge-cpp">Đặt chỗ &amp; Vé QR</span>
        <h4>Giữ chỗ trực tuyến nhanh chóng</h4>
        <p>Khách hàng chọn trước vị trí đỗ trống tại Khu A, B, C theo khung giờ mong muốn và nhận mã QR định danh ngay trên màn hình.</p>
      </div>
      <div class="arch-item">
        <span class="badge badge-cpp">Tính phí Minh bạch</span>
        <h4>Làm tròn theo khung 30 phút</h4>
        <p>Cước phí được tính tự động dựa trên đơn giá từng khu vực, làm tròn theo mỗi block 0.5 giờ và hỗ trợ thanh toán Tiền mặt hoặc Chuyển khoản QR.</p>
      </div>
      <div class="arch-item">
        <span class="badge badge-cpp">Đồng bộ Thời gian thực</span>
        <h4>Cập nhật sơ đồ bãi xe 24/7</h4>
        <p>Trạng thái các ô đỗ (Trống, Đã đặt, Đang có xe, Bảo trì) và báo cáo doanh thu được đồng bộ tức thì ngay khi có xe vào hoặc ra bãi.</p>
      </div>
    </div>

    <details class="dash-notes-details">
      <summary>Định nghĩa chỉ số &amp; Phương pháp tính cước phí (Nhấn để xem)</summary>
      <div class="dash-notes-body">
        <div>
          <strong>Tỷ lệ lấp đầy (Occupancy Rate):</strong> Tính bằng tổng số ô <code>Đang có xe (OCCUPIED)</code> cộng số ô <code>Đã đặt trước (RESERVED)</code> chia cho tổng số ô đỗ của khu vực.
        </div>
        <div>
          <strong>Công thức làm tròn cước phí:</strong> Thời gian gửi thực tế được quy đổi ra giờ và làm tròn lên theo từng nấc <code>0.5 giờ</code> (tối thiểu <code>1.0 giờ</code>). Phụ phí quá giờ đặt trước tính thêm <code>20%</code> trên phí cơ bản.
        </div>
      </div>
    </details>
  </div>
</section>
