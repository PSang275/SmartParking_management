@model SmartParking_management.Models.ViewModels.SmartParkingViewModel
@{
    var activeTab = Model?.ActiveTab ?? "map-tab";
    var pageTitle = Model?.PageTitle ?? "Sơ đồ Bãi xe & Kiểm tra Chỗ trống Thời gian thực";
    var pageSubtitle = Model?.PageSubtitle ?? "Theo dõi vị trí đỗ xe trực tiếp, đặt chỗ trước và kiểm soát xe vào/ra bằng mã QR";
}
<!DOCTYPE html>
<html lang="vi" data-theme="light" data-astryx-theme="neutral">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>@pageTitle — SmartPark</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/lib/astryx/fonts.css" asp-append-version="true">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/lib/astryx/astryx.css" asp-append-version="true">
  <link rel="stylesheet" href="/lib/astryx/theme-neutral.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/styles.css" asp-append-version="true">
</head>
<body data-initial-tab="@activeTab" class="astryx-root viz-root">
  <div class="app-shell">
    <!-- Left Sidebar Navigation — Baoyu Design & Claude Dashboard Craft -->
    <aside class="sidebar" aria-label="Điều hướng chính">
      <div class="sidebar-top">
        <div class="brand">
          <div class="brand-logo" aria-hidden="true">
            <svg class="ax-icon ax-icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="4"></rect>
              <path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path>
            </svg>
          </div>
          <div class="brand-text">
            <h1>Smart<span>Park</span></h1>
            <p>Quản trị &amp; Điều hành (Admin)</p>
          </div>
        </div>

        <div class="nav-group-label">ĐIỀU HÀNH TRỰC TIẾP</div>
        <nav class="nav-menu" aria-label="Các phân hệ">
          <button type="button" class="nav-btn @(activeTab == "map-tab" ? "active" : "")" data-tab="map-tab" data-route="/Admin/Map">
            <span class="nav-icon" aria-hidden="true">
              <svg class="ax-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              </svg>
            </span>
            <span>Sơ đồ &amp; Chỗ trống</span>
            <span class="nav-badge" id="nav-avail-badge">@(Model?.AvailableSlots ?? 0)</span>
          </button>

          <button type="button" class="nav-btn @(activeTab == "booking-tab" ? "active" : "")" data-tab="booking-tab" data-route="/Booking/Book">
            <span class="nav-icon" aria-hidden="true">
              <svg class="ax-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
                <path d="m9 16 2 2 4-4"></path>
              </svg>
            </span>
            <span>Đặt chỗ trước</span>
          </button>

          <button type="button" class="nav-btn @(activeTab == "qr-tab" ? "active" : "")" data-tab="qr-tab" data-route="/CheckInOut">
            <span class="nav-icon" aria-hidden="true">
              <svg class="ax-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="5" height="5" rx="1"></rect>
                <rect x="16" y="3" width="5" height="5" rx="1"></rect>
                <rect x="3" y="16" width="5" height="5" rx="1"></rect>
                <path d="M21 16h-3a2 2 0 0 0-2 2v3"></path>
                <path d="M21 21v.01"></path>
                <path d="M12 7v3a2 2 0 0 1-2 2H7"></path>
                <path d="M3 12h.01"></path>
                <path d="M12 3h.01"></path>
                <path d="M12 16v.01"></path>
                <path d="M16 12h1"></path>
                <path d="M21 12v.01"></path>
                <path d="M12 21v-1"></path>
              </svg>
            </span>
            <span>QR Check-in / Out</span>
          </button>

          <div class="nav-group-label" style="margin-top: 0.65rem;">QUẢN TRỊ &amp; PHÂN TÍCH</div>

          <button type="button" class="nav-btn @(activeTab == "vehicles-tab" ? "active" : "")" data-tab="vehicles-tab" data-route="/Vehicle">
            <span class="nav-icon" aria-hidden="true">
              <svg class="ax-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
                <circle cx="7" cy="17" r="2"></circle>
                <path d="M9 17h6"></path>
                <circle cx="17" cy="17" r="2"></circle>
              </svg>
            </span>
            <span>Đăng ký Phương tiện</span>
          </button>

          <button type="button" class="nav-btn @(activeTab == "slots-tab" ? "active" : "")" data-tab="slots-tab" data-route="/ParkingSlot">
            <span class="nav-icon" aria-hidden="true">
              <svg class="ax-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                <path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path>
              </svg>
            </span>
            <span>Quản lý Vị trí đỗ</span>
          </button>

          <button type="button" class="nav-btn @(activeTab == "history-tab" ? "active" : "")" data-tab="history-tab" data-route="/Invoice">
            <span class="nav-icon" aria-hidden="true">
              <svg class="ax-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <line x1="10" y1="9" x2="8" y2="9"></line>
              </svg>
            </span>
            <span>Lịch sử &amp; Hóa đơn</span>
          </button>

          <button type="button" class="nav-btn @(activeTab == "dashboard-tab" ? "active" : "")" data-tab="dashboard-tab" data-route="/Admin">
            <span class="nav-icon" aria-hidden="true">
              <svg class="ax-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </span>
            <span>Dashboard Thống kê</span>
          </button>
        </nav>
      </div>

      <div class="sidebar-footer">
        <div class="status-card">
          <div class="status-row">
            <span class="status-dot online" id="supabase-dot"></span>
            <span class="status-label">Trực tuyến • Tự động đồng bộ</span>
          </div>
          <p class="team-sub">Hoạt động 24/7 • Khu A, B, C</p>
        </div>
      </div>
    </aside>

    <!-- Main Workspace -->
    <div class="main-area">
      <!-- Top Bar (Claude Dashboard Short Header + Takeaway + Actions) -->
      <header class="topbar">
        <div class="topbar-title">
          <div class="topbar-meta-row">
            <span class="topbar-eyebrow">
              <span class="eyebrow-dot" aria-hidden="true"></span>
              SMARTPARK TELEMETRY
            </span>
            <span class="topbar-window-tag">Cập nhật tự động mỗi 5 giây</span>
          </div>
          <h2 id="page-heading">@pageTitle</h2>
          <p id="page-subheading">@pageSubtitle</p>
        </div>
        <div class="topbar-actions">
          <button type="button" class="btn btn-gold" id="btn-quick-checkin">
            <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="5" height="5" rx="1"></rect>
              <rect x="16" y="3" width="5" height="5" rx="1"></rect>
              <rect x="3" y="16" width="5" height="5" rx="1"></rect>
              <path d="M21 16h-3a2 2 0 0 0-2 2v3"></path>
              <path d="M12 7v3a2 2 0 0 1-2 2H7"></path>
            </svg>
            <span>Xe vào nhanh (QR)</span>
          </button>
          <button type="button" class="btn btn-royal-cta" onclick="document.querySelector('[data-tab=booking-tab]')?.click()">
            <span>Đặt chỗ ngay</span>
            <span class="cta-arrow" aria-hidden="true">
              <svg class="ax-icon ax-icon-xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </button>
          <button type="button" class="btn btn-outline" id="btn-toggle-tweaks" aria-expanded="false" aria-controls="baoyu-tweaks-panel" title="Tùy chỉnh giao diện">
            <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="21" x2="4" y2="14"></line>
              <line x1="4" y1="10" x2="4" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12" y2="3"></line>
              <line x1="20" y1="21" x2="20" y2="16"></line>
              <line x1="20" y1="12" x2="20" y2="3"></line>
              <line x1="1" y1="14" x2="7" y2="14"></line>
              <line x1="9" y1="8" x2="15" y2="8"></line>
              <line x1="17" y1="16" x2="23" y2="16"></line>
            </svg>
            <span>Giao diện</span>
          </button>
          <a href="/" class="btn btn-outline user-top-btn" style="text-decoration: none;" title="Xem Trang chủ Công khai dành cho Khách hàng">
            <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Trang chủ Khách hàng</span>
          </a>
          <a href="/Account/Login" class="btn btn-outline user-top-btn" id="admin-role-badge-btn" style="text-decoration: none;" title="Đổi vai trò / Đăng xuất">
            <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span id="admin-role-badge-label">Admin (admin)</span>
          </a>
        </div>
      </header>

      <!-- Baoyu Design In-Page Controls (Tweaks Panel) -->
      <aside id="baoyu-tweaks-panel" class="tweaks-panel" hidden aria-label="Bảng tùy chỉnh giao diện">
        <div class="tweaks-header">
          <strong>Tùy chỉnh Giao diện (Design Controls)</strong>
          <button type="button" class="btn-icon" id="btn-close-tweaks" aria-label="Đóng bảng tùy chỉnh">
            <svg class="ax-icon ax-icon-xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="tweaks-grid">
          <div class="tweak-group">
            <span class="tweak-label">Chế độ nền (Surface)</span>
            <div class="tweak-pills" role="group" aria-label="Chế độ nền">
              <button type="button" class="tweak-pill active" data-tweak-theme="light">Sáng (Light)</button>
              <button type="button" class="tweak-pill" data-tweak-theme="dark">Tối (Dark)</button>
            </div>
          </div>
          <div class="tweak-group">
            <span class="tweak-label">Màu chủ đạo (Accent)</span>
            <div class="tweak-pills" role="group" aria-label="Màu chủ đạo">
              <button type="button" class="tweak-pill active" data-tweak-accent="ocean"><i class="swatch-dot" style="background:#0064e0"></i>Ocean Blue</button>
              <button type="button" class="tweak-pill" data-tweak-accent="indigo"><i class="swatch-dot" style="background:#6250d6"></i>Indigo</button>
              <button type="button" class="tweak-pill" data-tweak-accent="teal"><i class="swatch-dot" style="background:#0d9488"></i>Emerald Teal</button>
              <button type="button" class="tweak-pill" data-tweak-accent="amber"><i class="swatch-dot" style="background:#eb6834"></i>Coral Orange</button>
            </div>
          </div>
        </div>
      </aside>

      @RenderBody()
    </div>
  </div>

  <!-- MODAL DIALOG: QR TICKET / INVOICE / SLOT INSPECTOR -->
  <dialog id="qr-modal" closedby="any" aria-labelledby="qr-modal-title">
    <div class="modal-inner">
      <header class="modal-header">
        <h3 id="qr-modal-title">Thẻ Vé QR &amp; Chi tiết Giao dịch</h3>
        <form method="dialog">
          <button type="submit" class="btn-icon" aria-label="Đóng hộp thoại">
            <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </form>
      </header>
      <div id="qr-modal-body" class="modal-body">
        <!-- Dynamically populated with SVG QR code and invoice details -->
      </div>
      <footer class="modal-footer" id="qr-modal-footer">
        <form method="dialog">
          <button type="submit" class="btn btn-outline" value="close" autofocus>Đóng</button>
        </form>
      </footer>
    </div>
  </dialog>

  <!-- Dataviz Floating Popover Tooltip -->
  <div id="dataviz-tooltip" class="viz-tooltip" hidden aria-hidden="true"></div>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="toast-container" aria-live="polite"></div>

  <script src="/js/qrcode.js" asp-append-version="true"></script>
  <script src="/js/app.js" asp-append-version="true"></script>
  <script>
    (() => {
      const ROLE_PROFILES = {
        ADMIN: {
          badge: 'Admin (admin)',
          sub: 'Quản trị viên hệ thống',
          defaultTab: 'dashboard-tab',
          tabs: ['map-tab', 'booking-tab', 'qr-tab', 'vehicles-tab', 'slots-tab', 'history-tab', 'dashboard-tab'],
          showRevenueKpi: true
        },
        MANAGER: {
          badge: 'Quản Lý Ca (manager)',
          sub: 'Điều hành ca & Vé tháng',
          defaultTab: 'map-tab',
          tabs: ['map-tab', 'booking-tab', 'qr-tab', 'vehicles-tab', 'slots-tab', 'history-tab'],
          showRevenueKpi: false
        },
        GATE_STAFF: {
          badge: 'NV Trực Cổng (gate_staff)',
          sub: 'Kiểm soát QR Vào / Ra cổng',
          defaultTab: 'qr-tab',
          tabs: ['qr-tab', 'map-tab'],
          showRevenueKpi: false
        },
        ACCOUNTANT: {
          badge: 'Kế Toán (accountant)',
          sub: 'Đối soát Hóa đơn & Doanh thu',
          defaultTab: 'history-tab',
          tabs: ['history-tab', 'dashboard-tab', 'vehicles-tab'],
          showRevenueKpi: true
        },
        TECHNICIAN: {
          badge: 'Kỹ Thuật Viên (technician)',
          sub: 'Trạm sạc EV & An toàn PCCC',
          defaultTab: 'slots-tab',
          tabs: ['slots-tab', 'map-tab'],
          showRevenueKpi: false
        }
      };

      document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        let role = (params.get('role') || '').toUpperCase();
        if (!ROLE_PROFILES[role]) {
          try {
            const saved = JSON.parse(localStorage.getItem('smartpark_auth_user') || 'null');
            if (saved && ROLE_PROFILES[saved.role]) role = saved.role;
          } catch {}
        }
        if (!ROLE_PROFILES[role]) role = 'ADMIN';

        const profile = ROLE_PROFILES[role];
        const badgeEl = document.getElementById('admin-role-badge-label');
        if (badgeEl) badgeEl.textContent = profile.badge;

        const brandSub = document.querySelector('.brand-text p');
        if (brandSub) brandSub.textContent = profile.sub;

        document.querySelectorAll('.nav-menu .nav-btn').forEach((btn) => {
          const tab = btn.getAttribute('data-tab');
          btn.style.display = profile.tabs.includes(tab) ? '' : 'none';
        });

        // Hide top revenue KPI card for roles that shouldn't see total owner revenue
        if (!profile.showRevenueKpi) {
          const revEl = document.getElementById('kpi-revenue');
          const revCard = revEl ? revEl.closest('.kpi-card') : null;
          if (revCard) revCard.style.display = 'none';
        }

        // Activate the appropriate starting tab if current active tab isn't allowed or if ?role= was passed
        if (params.has('role')) {
          const targetBtn = document.querySelector(`.nav-menu .nav-btn[data-tab="${profile.defaultTab}"]`);
          setTimeout(() => targetBtn?.click(), 60);
        }
      });
    })();
  </script>
</body>
</html>
