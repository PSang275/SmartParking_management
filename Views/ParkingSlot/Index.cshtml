@model SmartParking_management.Models.ViewModels.SmartParkingViewModel
@{
    var isActive = Model.ActiveTab == "slots-tab";
}
<section id="slots-tab" class="tab-panel @(isActive ? "active" : "")" @(isActive ? "" : "hidden")>
  <div class="split-layout">
    <div class="card">
      <div class="card-header">
        <h3>Thêm Ô đỗ mới / Cấu hình Khu vực</h3>
        <p>Dành cho Quản trị viên mở rộng quy mô bãi xe hoặc khóa ô bảo trì</p>
      </div>
      <form id="slot-form" class="modern-form" novalidate>
        <div class="field-row">
          <div class="field">
            <label for="sl-zone">Khu vực (Zone) *</label>
            <select id="sl-zone" name="zone_id" required></select>
          </div>
          <div class="field">
            <label for="sl-code">Mã ô đỗ (Slot Code) *</label>
            <span id="sl-code-hint" class="hint">VD: A-06, B-06, C-07</span>
            <input type="text" id="sl-code" name="slot_code" autocorrect="off" autocapitalize="off" spellcheck="false" required minlength="3" placeholder="A-06" aria-describedby="sl-code-hint" aria-errormessage="sl-code-err">
            <div id="sl-code-err" class="error-msg">Nhập mã ô đỗ hợp lệ.</div>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="sl-type">Loại phương tiện</label>
            <select id="sl-type" name="vehicle_type">
              <option value="CAR">Ô tô (CAR)</option>
              <option value="MOTORBIKE">Xe máy (MOTORBIKE)</option>
            </select>
          </div>
          <div class="field">
            <label for="sl-status">Trạng thái ban đầu</label>
            <select id="sl-status" name="status">
              <option value="AVAILABLE">AVAILABLE (Trống)</option>
              <option value="MAINTENANCE">MAINTENANCE (Bảo trì)</option>
            </select>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block">
          <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
            <path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path>
          </svg>
          <span>Thêm Ô đỗ vào Bãi xe</span>
        </button>
      </form>

      <hr class="divider">

      <h4>Bảng giá niêm yết theo Khu vực</h4>
      <div class="zones-pricing-list" id="zones-pricing-cards"></div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3>Danh mục Vị trí đỗ &amp; Điều khiển Trạng thái</h3>
        <p>Chuyển nhanh trạng thái ô giữa Trống (AVAILABLE) và Bảo trì (MAINTENANCE)</p>
      </div>
      <div tabindex="0" role="region" aria-labelledby="slots-table-caption" class="table-wrapper">
        <table id="slots-table">
          <caption id="slots-table-caption" class="sr-only">Bảng quản lý tất cả vị trí đỗ xe</caption>
          <thead>
            <tr>
              <th>Mã Ô</th>
              <th>Khu vực</th>
              <th>Loại xe / Giá</th>
              <th>Trạng thái</th>
              <th>Điều khiển</th>
            </tr>
          </thead>
          <tbody id="slots-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</section>
