@model SmartParking_management.Models.ViewModels.SmartParkingViewModel
@{
    var isActive = Model.ActiveTab == "qr-tab";
}
<section id="qr-tab" class="tab-panel @(isActive ? "active" : "")" @(isActive ? "" : "hidden")>
  <div class="split-layout">
    <!-- Left: QR Scanner & Check-in -->
    <div class="card">
      <div class="card-header">
        <h3>Cổng Kiểm soát QR Check-in (Xe vào bãi)</h3>
        <p>Quét mã QR đặt chỗ trước hoặc cấp vé QR trực tiếp cho xe vãng lai</p>
      </div>

      <div class="subcard">
        <h4>1. Quét mã QR Đặt chỗ trước</h4>
        <div class="qr-input-group">
          <input type="text" id="qr-checkin-input" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="Nhập hoặc chọn mã QR-BK-... bên dưới" aria-label="Mã QR đặt chỗ">
          <button type="button" class="btn btn-primary" id="btn-verify-booking-qr">
            <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="5" height="5" rx="1"></rect>
              <rect x="16" y="3" width="5" height="5" rx="1"></rect>
              <rect x="3" y="16" width="5" height="5" rx="1"></rect>
              <path d="M21 16h-3a2 2 0 0 0-2 2v3"></path>
              <path d="M12 7v3a2 2 0 0 1-2 2H7"></path>
            </svg>
            <span>Quét &amp; Cho xe vào</span>
          </button>
        </div>
        <div class="quick-chips" id="pending-booking-chips"></div>
      </div>

      <hr class="divider">

      <form id="walkin-checkin-form" class="modern-form" novalidate>
        <h4>2. Xe vãng lai vào bãi (Cấp vé trực tiếp)</h4>
        <div class="field-row">
          <div class="field">
            <label for="wi-plate">Biển số xe vào *</label>
            <span id="wi-plate-hint" class="hint">VD: 51K-888.99 hoặc 59X3-456.78</span>
            <input type="text" id="wi-plate" name="license_plate" autocorrect="off" autocapitalize="off" spellcheck="false" required minlength="5" placeholder="51K-888.99" aria-describedby="wi-plate-hint" aria-errormessage="wi-plate-err">
            <div id="wi-plate-err" class="error-msg">Nhập biển số tối thiểu 5 ký tự.</div>
          </div>
          <div class="field">
            <label for="wi-type">Loại phương tiện *</label>
            <span class="hint">Tự động lọc ô đỗ phù hợp</span>
            <select id="wi-type" name="vehicle_type" required>
              <option value="CAR">Ô tô (CAR)</option>
              <option value="MOTORBIKE">Xe máy (MOTORBIKE)</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="wi-slot">Chọn ô đỗ trống cấp cho xe *</label>
          <span class="hint">Hệ thống tự động chuyển ô sang Đang đỗ</span>
          <select id="wi-slot" name="slot_id" required></select>
        </div>
        <button type="submit" class="btn btn-success btn-block">
          <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Cấp vé QR Check-in &amp; Mở Barie</span>
        </button>
      </form>
    </div>

    <!-- Right: QR Check-out & Fee Calculator -->
    <div class="card">
      <div class="card-header">
        <h3>Cổng Kiểm soát QR Check-out &amp; Tính phí tự động</h3>
        <p>Chọn phiên xe đang đỗ hoặc quét mã QR vé lượt để tính phí &amp; thanh toán</p>
      </div>

      <div class="qr-input-group">
        <input type="text" id="qr-checkout-input" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="Nhập mã vé QR-IN-... hoặc bấm chọn xe đang đỗ" aria-label="Mã QR vé lượt ra bãi">
        <button type="button" class="btn btn-warning" id="btn-preview-checkout">
          <svg class="ax-icon ax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="2" width="16" height="20" rx="2"></rect>
            <line x1="8" y1="6" x2="16" y2="6"></line>
            <line x1="16" y1="14" x2="16" y2="18"></line>
            <path d="M16 10h.01"></path>
            <path d="M12 10h.01"></path>
            <path d="M8 10h.01"></path>
            <path d="M12 14h.01"></path>
            <path d="M8 14h.01"></path>
            <path d="M12 18h.01"></path>
            <path d="M8 18h.01"></path>
          </svg>
          <span>Tính phí Check-out</span>
        </button>
      </div>

      <div class="active-sessions-list" id="active-sessions-cards">
        <!-- Active sessions populated dynamically -->
      </div>

      <!-- Fee Calculator Simulator -->
      <div class="cpp-simulator-box">
        <div class="sim-header">
          <span class="badge badge-cpp">Bảng tính nhanh</span>
          <h4>Ước tính cước phí đỗ xe theo thời gian</h4>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="sim-rate">Đơn giá / giờ (VNĐ)</label>
            <input type="number" id="sim-rate" value="25000" step="5000" min="5000">
          </div>
          <div class="field">
            <label for="sim-minutes">Số phút gửi thực tế</label>
            <input type="number" id="sim-minutes" value="145" step="15" min="1">
          </div>
          <div class="field">
            <label for="sim-overtime">Quá giờ đặt trước?</label>
            <select id="sim-overtime">
              <option value="false">Đúng giờ (0%)</option>
              <option value="true">Quá giờ (+20%)</option>
            </select>
          </div>
        </div>
        <div class="sim-result" id="sim-result-box">
          Làm tròn: <strong>2.5 giờ</strong> • Phí cơ bản: <strong>62.500 ₫</strong> • Tổng thu: <strong>62.500 ₫</strong>
        </div>
      </div>
    </div>
  </div>
</section>
